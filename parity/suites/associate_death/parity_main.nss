#include "parity_inc"
void Remember(object c,int type,int hp,int mode){object a=GetAssociate(type,c);SetLocalObject(c,"OLD",a);SetLocalString(a,"AUDIT_KEY",GetTag(c));SetEventScript(a,EVENT_SCRIPT_CREATURE_ON_DEATH,"assoc_death");SetCurrentHitPoints(c,hp);SetLocalInt(c,"BEFOREHP",GetCurrentHitPoints(c));SetLocalInt(c,"BEFOREXP",GetXP(c));}
void Kill(object c,int mode){object a=GetLocalObject(c,"OLD");if(mode==1)DestroyObject(a);else ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectDeath(),a);}
void Report(string key,object c,int type,int feat,int hp,int mode){object a=GetLocalObject(c,"OLD");int lost=GetLocalInt(c,"BEFOREHP")-GetCurrentHitPoints(c);int max=hp-1;if(max>6)max=6;PLogI(key+".masteralive",!GetIsDead(c));PLogI(key+".damagevalid",(type==ASSOCIATE_TYPE_FAMILIAR&&mode!=1)?(lost>=0&&lost<=max&&(hp==1||lost>0)):lost==0);WriteTimestampedLogEntry("ASSOCIATE_DEATH|"+key+"|hp="+IntToString(GetCurrentHitPoints(c))+"|lost="+IntToString(lost));PLogI(key+".xpdelta",GetXP(c)-GetLocalInt(c,"BEFOREXP"));PLogI(key+".uses",GetFeatRemainingUses(feat,c));PLogI(key+".oldvalid",GetIsObjectValid(a));PLogI(key+".olddead",GetIsObjectValid(a)&&GetIsDead(a));PLogI(key+".samefaction",GetFactionEqual(a,c));if(GetIsObjectValid(a)){int f;for(f=0;f<4;f++)PLogI(key+".faction"+IntToString(f),GetFactionEqual(a,GetObjectByTag("FACTION"+IntToString(f))));}PLogI(key+".associatevalid",GetIsObjectValid(GetAssociate(type,c)));PLogI(key+".masterretained",GetMaster(a)==c);PLogI(key+".type",GetAssociateType(a));}
void Case(int i,string key,int type,int hp,int mode){string res="sum_wiz20";int feat=FEAT_SUMMON_FAMILIAR;if(type==ASSOCIATE_TYPE_ANIMALCOMPANION){res="sum_dru10";feat=FEAT_ANIMAL_COMPANION;}object c=CreateObject(OBJECT_TYPE_CREATURE,res,PCentre(IntToFloat(i%4)*35.0,IntToFloat(i/4)*35.0),FALSE,key);SetAILevel(c,AI_LEVEL_NORMAL);DelayCommand(2.0,AssignCommand(c,ActionUseFeat(feat,c)));DelayCommand(8.0,Remember(c,type,hp,mode));DelayCommand(9.0,Kill(c,mode));DelayCommand(11.0,Report(key+".early",c,type,feat,hp,mode));DelayCommand(18.0,Report(key+".late",c,type,feat,hp,mode));}
void main(){int f;for(f=0;f<4;f++){object control=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",PCentre(120.0,IntToFloat(f)*15.0),FALSE,"FACTION"+IntToString(f));ChangeToStandardFaction(control,f);SetAILevel(control,AI_LEVEL_VERY_LOW);}Case(0,"fam1",3,1,0);Case(1,"fam2",3,2,0);Case(2,"fam100",3,100,0);Case(3,"famdestroy",3,100,1);Case(4,"comp1",2,1,0);Case(5,"comp2",2,2,0);Case(6,"comp100",2,100,0);Case(7,"compdestroy",2,100,1);DelayCommand(20.0,PDone());}
