#include "parity_inc"
void Report(string key,object c,int spell,int cls=CLASS_TYPE_CLERIC) {
 int d;for(d=0;d<=6;d++) {
  PLogI(key+".none.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_NONE,d));
  PLogI(key+".empower.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_EMPOWER,d));
  PLogI(key+".extend.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_EXTEND,d));
  PLogI(key+".max.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_MAXIMIZE,d));
  PLogI(key+".quicken.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_QUICKEN,d));
  PLogI(key+".silent.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_SILENT,d));
  PLogI(key+".still.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_STILL,d));
  PLogI(key+".any.d"+IntToString(d),GetSpellUsesLeft(c,cls,spell,METAMAGIC_ANY,d));
 }
 PLogI(key+".otherClass",GetSpellUsesLeft(c,CLASS_TYPE_WIZARD,spell));
}
void Case(int index,string profile,int spell,int level,int meta,int marker) {
 object c=CreateObject(OBJECT_TYPE_CREATURE,profile,PCentre());string key=IntToString(index);
 int l;int n;for(l=0;l<10;l++)for(n=0;n<GetMemorizedSpellCountByLevel(c,CLASS_TYPE_CLERIC,l);n++)SetMemorizedSpellReady(c,CLASS_TYPE_CLERIC,l,n,FALSE);
 PLogI(key+".level",GetLevelByClass(CLASS_TYPE_CLERIC,c));
 PLogI(key+".domain1",GetDomain(c,1,CLASS_TYPE_CLERIC));PLogI(key+".domain2",GetDomain(c,2,CLASS_TYPE_CLERIC));
 SetMemorizedSpell(c,CLASS_TYPE_CLERIC,level,0,spell,TRUE,meta,marker);
 PLogI(key+".stored",GetMemorizedSpellId(c,CLASS_TYPE_CLERIC,level,0));
 PLogI(key+".meta",GetMemorizedSpellMetaMagic(c,CLASS_TYPE_CLERIC,level,0));
 PLogI(key+".ready",GetMemorizedSpellReady(c,CLASS_TYPE_CLERIC,level,0));
 PLogI(key+".marker",GetMemorizedSpellIsDomainSpell(c,CLASS_TYPE_CLERIC,level,0));
 Report(key+".ready",c,spell);
 SetMemorizedSpellReady(c,CLASS_TYPE_CLERIC,level,0,FALSE);Report(key+".spent",c,spell);
 DestroyObject(c);
}
void Aggregate() {
 object c=CreateObject(OBJECT_TYPE_CREATURE,"dc_magicall",PCentre());
 int l;int n;for(l=0;l<10;l++)for(n=0;n<GetMemorizedSpellCountByLevel(c,CLASS_TYPE_CLERIC,l);n++)SetMemorizedSpellReady(c,CLASS_TYPE_CLERIC,l,n,FALSE);
 SetMemorizedSpell(c,CLASS_TYPE_CLERIC,2,0,102,TRUE,0,1);
 SetMemorizedSpell(c,CLASS_TYPE_CLERIC,2,1,102,TRUE,2,0);
 SetMemorizedSpell(c,CLASS_TYPE_CLERIC,2,2,102,TRUE,4,1);
 Report("aggregate.three",c,102);
 SetMemorizedSpellReady(c,CLASS_TYPE_CLERIC,2,1,FALSE);Report("aggregate.two",c,102);
 DestroyObject(c);
}
void Wizard() {
 object c=CreateObject(OBJECT_TYPE_CREATURE,"dc_wizard",PCentre());
 PLogI("wizard.level",GetLevelByClass(CLASS_TYPE_WIZARD,c));
 int l;int n;for(l=0;l<10;l++)for(n=0;n<GetMemorizedSpellCountByLevel(c,CLASS_TYPE_WIZARD,l);n++)SetMemorizedSpellReady(c,CLASS_TYPE_WIZARD,l,n,FALSE);
 SetMemorizedSpell(c,CLASS_TYPE_WIZARD,1,0,102,TRUE,2,1);
 SetMemorizedSpell(c,CLASS_TYPE_WIZARD,2,0,102,TRUE,0,0);
 SetMemorizedSpell(c,CLASS_TYPE_WIZARD,4,0,102,TRUE,0,1);
 Report("wizard.ready",c,102,CLASS_TYPE_WIZARD);
}
