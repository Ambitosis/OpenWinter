#include "parity_inc"
void Quiet(object o){int n;for(n=5000;n<=5012;n++)SetEventScript(o,n,"");SetAILevel(o,AI_LEVEL_NORMAL);SetPlotFlag(o,TRUE);AssignCommand(o,ClearAllActions(TRUE));}
object Actor(int id,string key){object a=CreateObject(OBJECT_TYPE_CREATURE,"nw_drowfight010",Location(GetObjectByTag("PARITY_AREA"),Vector(12.0,12.0+IntToFloat(id)*16.0,0.0),0.0));Quiet(a);SetLocalString(a,"key",key);SetLocalLocation(a,"start",GetLocation(a));SetLocalObject(GetModule(),"a"+IntToString(id),a);return a;}
void Cast(int id){object a=GetLocalObject(GetModule(),"a"+IntToString(id));PLogI("spell"+IntToString(id)+".valid",GetIsObjectValid(a));AssignCommand(a,ActionCastSpellAtLocation(id,GetLocalLocation(a,"aim"),METAMAGIC_NONE,TRUE));}
void Spell(int id,float distance){object a=Actor(id,"spell"+IntToString(id));vector v=GetPosition(a);v.x+=distance;SetLocalLocation(a,"aim",Location(GetArea(a),v,0.0));DelayCommand(7.0,Cast(id));}
void Attack(int id,int expected){object a=GetLocalObject(GetModule(),"a"+IntToString(id));object t=GetLocalObject(a,"target");PLogI("weapon"+IntToString(id)+".equipped",GetBaseItemType(GetItemInSlot(INVENTORY_SLOT_RIGHTHAND,a))==expected);PLogI("weapon"+IntToString(id)+".seen",GetObjectSeen(t,a));AssignCommand(a,ActionAttack(t));}
void Weapon(int id,string weapon,string ammo,int slot,int expected){object a=Actor(id,"weapon"+IntToString(id));object it=GetFirstItemInInventory(a);while(GetIsObjectValid(it)){DestroyObject(it);it=GetNextItemInInventory(a);}vector v=GetPosition(a);v.x+=40.0;object t=CreateObject(OBJECT_TYPE_CREATURE,"nw_bandit001",Location(GetArea(a),v,180.0));Quiet(t);SetPlotFlag(a,FALSE);SetPlotFlag(t,FALSE);SetImmortal(a,TRUE);SetImmortal(t,TRUE);ChangeToStandardFaction(a,STANDARD_FACTION_HOSTILE);ChangeToStandardFaction(t,STANDARD_FACTION_COMMONER);SetEventScript(t,EVENT_SCRIPT_CREATURE_ON_MELEE_ATTACKED,"rg_attacked");SetLocalObject(a,"target",t);object w=CreateItemOnObject(weapon,a,99);if(ammo!="")SetItemStackSize(w,1);AssignCommand(a,ActionEquipItem(w,INVENTORY_SLOT_RIGHTHAND));if(ammo!=""){object m=CreateItemOnObject(ammo,a,99);AssignCommand(a,ActionEquipItem(m,slot));}DelayCommand(7.0,Attack(id,expected));}
void End(){int i;for(i=0;i<8;i++){object a=GetLocalObject(GetModule(),"a"+IntToString(i));PLogI(GetLocalString(a,"key")+".executed",GetLocalInt(a,"executed"));if(i>=4){PLogI(GetLocalString(a,"key")+".action",GetCurrentAction(a));PLogF(GetLocalString(a,"key")+".finalDistance",GetDistanceBetween(a,GetLocalObject(a,"target")),0.5);}}PDone();}
void main(){PLog("table.short",Get2DAString("ranges","PrimaryRange",2));PLog("table.weapon",Get2DAString("ranges","PrimaryRange",6));Spell(0,7.0);Spell(1,11.0);Spell(2,14.0);Spell(3,4.0);Weapon(4,"nw_wbwln001","nw_wamar001",INVENTORY_SLOT_ARROWS,8);Weapon(5,"nw_wbwxl001","nw_wambo001",INVENTORY_SLOT_BOLTS,7);Weapon(6,"nw_wbwsl001","nw_wambu001",INVENTORY_SLOT_BULLETS,61);Weapon(7,"nw_wthdt001","",0,31);DelayCommand(22.0,End());}
