#include "parity_inc"
void Report(string key,object c,int level){object a=GetAssociate(ASSOCIATE_TYPE_SUMMONED,c);PLogI(key+".valid",GetIsObjectValid(a));PLog(key+".resref",GetResRef(a));PLogI(key+".ready",GetMemorizedSpellReady(c,CLASS_TYPE_WIZARD,level,0));effect e=GetFirstEffect(c);while(GetIsEffectValid(e)){if(GetEffectType(e,TRUE)==100){PLogI(key+".duration",GetEffectDuration(e));PLogI(key+".casterlevel",GetEffectCasterLevel(e));PLogI(key+".spell",GetEffectSpellId(e));}e=GetNextEffect(c);}}
void Cast(object c,int meta){AssignCommand(c,ActionCastSpellAtLocation(SPELL_SUMMON_CREATURE_I,GetLocation(c),meta,FALSE,PROJECTILE_PATH_TYPE_DEFAULT,FALSE,CLASS_TYPE_WIZARD));}
void Case(int i,int casterlevel,int meta){string key="level"+IntToString(casterlevel)+".meta"+IntToString(meta);object c=CreateObject(OBJECT_TYPE_CREATURE,"sd_wiz"+IntToString(casterlevel),PCentre(IntToFloat(i)*30.0,0.0));SetAILevel(c,AI_LEVEL_NORMAL);int slotlevel=1;if(meta==METAMAGIC_EXTEND){slotlevel=2;ApplyEffectToObject(DURATION_TYPE_PERMANENT,EffectBonusFeat(FEAT_EXTEND_SPELL),c);SetMemorizedSpell(c,CLASS_TYPE_WIZARD,2,0,SPELL_SUMMON_CREATURE_I,TRUE,meta);}DelayCommand(2.0,Cast(c,meta));DelayCommand(10.0,Report(key,c,slotlevel));}
void main(){Case(0,1,METAMAGIC_NONE);Case(1,20,METAMAGIC_NONE);Case(2,3,METAMAGIC_EXTEND);Case(3,20,METAMAGIC_EXTEND);DelayCommand(12.0,PDone());}
