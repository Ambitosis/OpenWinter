#include "parity_inc"
void Summon(object target,float duration,int blank=0,int kind=DURATION_TYPE_TEMPORARY){string res="nw_s_badgerdire";if(blank)res="";effect e=EffectSummonCreature(res,-1,2.0,FALSE,-1,target);int n=GetLocalInt(OBJECT_SELF,"CALL");SetLocalInt(OBJECT_SELF,"CALL",n+1);PLogI(GetTag(OBJECT_SELF)+".constructor"+IntToString(n),GetIsEffectValid(e));ApplyEffectAtLocation(kind,e,GetLocation(OBJECT_SELF),duration);}
void Report(string key,object c,object target){object a=GetAssociate(ASSOCIATE_TYPE_SUMMONED,c);PLogI(key+".targetvalid",GetIsObjectValid(target));PLogF(key+".distance",GetIsObjectValid(target)?GetDistanceBetween(c,target):-1.0,0.2);PLogI(key+".associatevalid",GetIsObjectValid(a));PLogI(key+".same",a==target);PLogI(key+".targetmaster",GetMaster(target)==c);PLogI(key+".targettype",GetAssociateType(target));PLog(key+".associate_resref",GetResRef(a));int count=0;effect e=GetFirstEffect(c);while(GetIsEffectValid(e)){if(GetEffectType(e,TRUE)==100)count++;e=GetNextEffect(c);}PLogI(key+".effects",count);}
void RemoveOld(object c){RemoveEffect(c,GetFirstEffect(c));}
void Case(int index,string key,int mode,int blank,int kind=DURATION_TYPE_TEMPORARY){object c=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",PCentre(IntToFloat(index%4)*30.0,IntToFloat(index/4)*35.0),FALSE,key);object target=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",PCentre(IntToFloat(index%4)*30.0,IntToFloat(index/4)*35.0+10.0));if(mode==4)target=c;if(mode==5)AddHenchman(c,target);SetAILevel(c,AI_LEVEL_VERY_LOW);SetAILevel(target,AI_LEVEL_VERY_LOW);AssignCommand(c,Summon(target,6.0,blank,kind));DelayCommand(0.2,Report(key+".first",c,target));if(mode==1)DelayCommand(3.0,AssignCommand(c,Summon(target,10.0,blank,kind)));if(mode==2)DelayCommand(3.0,AssignCommand(c,Summon(OBJECT_INVALID,10.0,blank,kind)));if(mode==3)DelayCommand(3.0,RemoveOld(c));DelayCommand(5.5,Report(key+".changed",c,target));DelayCommand(7.5,Report(key+".oldexpiry",c,target));DelayCommand(14.0,Report(key+".newexpiry",c,target));}
void main(){Case(0,"namedexpiry",0,0);Case(1,"namedreuse",1,0);Case(2,"namedreplacement",2,0);Case(3,"namedremove",3,0);Case(4,"adoptexpiry",0,1);Case(5,"adoptreuse",1,1);Case(6,"adoptinvalid",2,1);Case(7,"adoptremove",3,1);Case(8,"adoptself",4,1);Case(9,"adopthench",5,1);Case(10,"adoptinstant",0,1,DURATION_TYPE_INSTANT);Case(11,"adoptpermanent",0,1,DURATION_TYPE_PERMANENT);Case(12,"namedinstant",0,0,DURATION_TYPE_INSTANT);Case(13,"namedpermanent",0,0,DURATION_TYPE_PERMANENT);DelayCommand(16.0,PDone());}
