#include "parity_inc"
string Effects(object o){string s="";effect e=GetFirstEffect(o);int n=0;while(GetIsEffectValid(e)&&n<20){s+=IntToString(GetEffectType(e,TRUE))+":"+IntToString(GetEffectDurationType(e))+":"+IntToString(GetEffectDuration(e))+" ";e=GetNextEffect(o);n++;}return s;}
void Report(string key,object c,object t){PLog(key+".casterfx",Effects(c));PLog(key+".targetfx",Effects(t));PLogI(key+".casterassociate",GetIsObjectValid(GetAssociate(ASSOCIATE_TYPE_SUMMONED,c)));PLogI(key+".targetassociate",GetIsObjectValid(GetAssociate(ASSOCIATE_TYPE_SUMMONED,t)));}
void Apply(int kind,float duration,object target,int mode){effect e=EffectSummonCreature("nw_s_badgerdire",-1,1.0,FALSE,-1);if(mode==1)e=MagicalEffect(e);if(mode==2)ApplyEffectToObject(kind,e,target,duration);else ApplyEffectAtLocation(kind,e,GetLocation(OBJECT_SELF),duration);}
void Remove(object c){RemoveEffect(c,GetFirstEffect(c));}
void DestroyMaster(object c){SetLocalObject(GetModule(),GetTag(c),GetAssociate(ASSOCIATE_TYPE_SUMMONED,c));DestroyObject(c);}
void DeadReport(string key,object c){object summon=GetLocalObject(GetModule(),GetStringLeft(key,GetStringLength(key)-6));PLogI(key+".summonvalid",GetIsObjectValid(summon));PLogI(key+".associatevalid",GetIsObjectValid(GetAssociate(ASSOCIATE_TYPE_SUMMONED,c)));PLog(key+".effects",Effects(c));}
void DeathCase(int i,string key,int mode){object c=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",PCentre(IntToFloat(i)*20.0,100.0),FALSE,key);AssignCommand(c,Apply(DURATION_TYPE_TEMPORARY,8.0,c,0));if(mode==0)DelayCommand(2.0,DestroyMaster(c));else DelayCommand(2.0,ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectDeath(),c));DelayCommand(3.0,DeadReport(key+".early",c));DelayCommand(3.1,PLogI(key+".storedvalid",GetIsObjectValid(GetLocalObject(GetModule(),key))));DelayCommand(14.0,PLogI(key+".latevalid",GetIsObjectValid(GetLocalObject(GetModule(),key))));}
void Case(int i,string key,int kind,float duration,int mode){object c=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",PCentre(IntToFloat(i%4)*25.0,IntToFloat(i/4)*25.0));object t=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",PCentre(IntToFloat(i%4)*25.0+5.0,IntToFloat(i/4)*25.0));AssignCommand(c,Apply(kind,duration,t,mode));DelayCommand(0.2,Report(key+".pending",c,t));DelayCommand(2.0,Report(key+".spawned",c,t));if(mode==1)DelayCommand(3.0,ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectDispelMagicAll(100),c));else DelayCommand(3.0,Remove(c));DelayCommand(4.5,Report(key+".removed",c,t));}
void Nearby(string key,location loc){int n=0;object o=GetFirstObjectInArea(GetAreaFromLocation(loc));while(GetIsObjectValid(o)){if(GetResRef(o)=="nw_s_badgerdire"&&GetDistanceBetweenLocations(loc,GetLocation(o))<6.0)n++;o=GetNextObjectInArea(GetAreaFromLocation(loc));}PLogI(key,n);}
void PendingDestroy(){location loc=PCentre(100.0,100.0);object c=CreateObject(OBJECT_TYPE_CREATURE,"sum_wiz20",loc);AssignCommand(c,Apply(DURATION_TYPE_TEMPORARY,5.0,c,0));DelayCommand(0.2,DestroyObject(c));DelayCommand(2.0,Nearby("pendingdestroy.arrival",loc));DelayCommand(6.0,Nearby("pendingdestroy.expiry",loc));}
void main(){PendingDestroy();Case(0,"instant",DURATION_TYPE_INSTANT,0.0,0);Case(1,"permanent",DURATION_TYPE_PERMANENT,0.0,0);Case(2,"zero",DURATION_TYPE_TEMPORARY,0.0,0);Case(3,"target",DURATION_TYPE_TEMPORARY,10.0,2);Case(4,"dispel",DURATION_TYPE_TEMPORARY,10.0,1);DeathCase(0,"destroycaster",0);DeathCase(1,"killcaster",1);DelayCommand(15.0,PDone());}
