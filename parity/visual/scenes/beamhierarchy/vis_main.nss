#include "visual_inc"
void Apply(object source,object target){WriteTimestampedLogEntry("VISUAL|note|beam|source."+IntToString(GetIsObjectValid(source))+".target."+IntToString(GetIsObjectValid(target)));ApplyEffectToObject(DURATION_TYPE_TEMPORARY,EffectBeam(73,source,BODY_NODE_HAND),target,5.0);}
void Quiet(object o){int i;for(i=5000;i<=5012;i++)SetEventScript(o,i,"");SetCommandable(FALSE,o);SetPlotFlag(o,TRUE);}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;if(Get2DAString("progfx","Param1",600)!="bg_probe"){WriteTimestampedLogEntry("VISUAL|note|gate_fail|model");VDone();return;}VBegin(pc);VHidePC(pc);object source=VSpawn(pc,"nw_bandit001",-1.5,1.0,90.0);object target=VSpawn(pc,"nw_bandit001",1.5,5.0,270.0);Quiet(source);Quiet(target);WriteTimestampedLogEntry("VISUAL|note|model|"+Get2DAString("progfx","Param1",600));WriteTimestampedLogEntry("VISUAL|note|animation|"+Get2DAString("progfx","Param2",600));DelayCommand(1.0,VCamera(pc,270.0,8.0,65.0));DelayCommand(2.0,VShot("baseline"));DelayCommand(3.0,Apply(source,target));DelayCommand(3.2,VShot("start020"));DelayCommand(3.8,VShot("start080"));DelayCommand(4.4,VShot("start140"));DelayCommand(5.4,VShot("start240"));DelayCommand(7.5,VShot("active450"));DelayCommand(8.5,VShot("expired"));DelayCommand(9.0,VDone());}
