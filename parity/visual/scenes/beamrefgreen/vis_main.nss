#include "visual_inc"
void Note(string k,string v){WriteTimestampedLogEntry("VISUAL|note|"+k+"|"+v);}
void Quiet(object o){int i;for(i=5000;i<=5012;i++)SetEventScript(o,i,"");SetCommandable(FALSE,o);SetPlotFlag(o,TRUE);}
void Direct(object a,object b){Note("direct.models",Get2DAString("visualeffects","Imp_Root_M_Node",210)+"."+Get2DAString("visualeffects","Imp_Root_M_Node",211));ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectVisualEffect(210),a);ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectVisualEffect(211),b);}
void Beam(object a,object b){Note("beam.model",Get2DAString("progfx","Param1",602));ApplyEffectToObject(DURATION_TYPE_TEMPORARY,EffectBeam(212,a,BODY_NODE_CHEST),b,3.0);}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;VBegin(pc);object a=VSpawn(pc,"nw_skeleton",-2.0,0.0,0.0);object b=VSpawn(pc,"nw_bandit001",2.0,0.0,180.0);Quiet(a);Quiet(b);Note("objects",IntToString(GetIsObjectValid(a))+"."+IntToString(GetIsObjectValid(b)));DelayCommand(1.0,VCamera(pc,270.0,7.0,65.0));DelayCommand(2.0,VShot("baseline"));DelayCommand(3.0,Direct(a,b));DelayCommand(3.5,VShot("direct_050"));DelayCommand(4.5,VShot("direct_150"));DelayCommand(7.0,VShot("direct_clear"));DelayCommand(8.0,Beam(a,b));DelayCommand(8.5,VShot("reference_050"));DelayCommand(9.5,VShot("reference_150"));DelayCommand(11.5,VShot("reference_clear"));DelayCommand(12.0,VDone());}
