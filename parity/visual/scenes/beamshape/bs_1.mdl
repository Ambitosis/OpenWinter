# Authored beam blend discriminator; all geometry and emitter values equal.
newmodel bs_1
setsupermodel bs_1 NULL
classification Effects
setanimationscale 1
beginmodelgeom bs_1
node dummy bs_1
 parent NULL
endnode
node emitter bolt
 parent bs_1
 position 0 0 0
 update Lightning
 render Linked
 blend Normal
 texture fxpa_white
 birthrate 3
 lifeExp 1
 sizeStart 0.15
 sizeEnd 0.15
 colorStart 1 0 0
 colorEnd 1 0 0
 alphaStart 1
 alphaEnd 1
 lightningDelay 0
 lightningRadius 0
 lightningScale 1
 inherit_local 1
endnode
node reference endpoint
 parent bolt
 position 0 0 1
 refmodel fx_ref
 reattachable 1
endnode
endmodelgeom bs_1
donemodel bs_1
