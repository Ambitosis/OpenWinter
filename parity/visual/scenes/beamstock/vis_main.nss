#include "visual_inc"
void Note(string key,string value){WriteTimestampedLogEntry("VISUAL|note|"+key+"|"+value);}
void Quiet(object o){int i;for(i=5000;i<=5012;i++)SetEventScript(o,i,"");SetCommandable(FALSE,o);SetPlotFlag(o,TRUE);}
int Gate(int vfx,string expected){int row=StringToInt(Get2DAString("visualeffects","ProgFX_Duration",vfx));string model=Get2DAString("progfx","Param1",row);Note("model"+IntToString(vfx),model);return model==expected;}
void Apply(object source,object target,int vfx,string label){Note(label+".applied",IntToString(GetIsObjectValid(source))+"."+IntToString(GetIsObjectValid(target)));ApplyEffectToObject(DURATION_TYPE_TEMPORARY,EffectBeam(vfx,source,BODY_NODE_CHEST),target,2.5);DelayCommand(.4,VShot(label+"_040"));DelayCommand(1.2,VShot(label+"_120"));DelayCommand(2.0,VShot(label+"_200"));DelayCommand(3.0,VShot(label+"_clear"));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;if(!Gate(485,"vim_rayblack")||!Gate(484,"vim_raychain")||!Gate(73,"vdu_beam000")){Note("gate_fail","model");VDone();return;}VBegin(pc);object source=VSpawn(pc,"nw_skeleton",-2.0,0.0,0.0);object target=VSpawn(pc,"nw_bandit001",2.0,0.0,180.0);Quiet(source);Quiet(target);DelayCommand(1.0,VCamera(pc,270.0,7.0,65.0));DelayCommand(2.0,VShot("baseline"));DelayCommand(3.0,Apply(source,target,485,"black"));DelayCommand(7.0,Apply(source,target,484,"chain"));DelayCommand(11.0,Apply(source,target,73,"lightning"));DelayCommand(15.0,VDone());}
