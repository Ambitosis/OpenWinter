# Authored beam blend discriminator; all geometry and emitter values equal.
newmodel bw_2
setsupermodel bw_2 NULL
classification Effects
setanimationscale 1
beginmodelgeom bw_2
node dummy bw_2
 parent NULL
endnode
node emitter bolt
 parent bw_2
 position 0 0 0
 update Lightning
 render Linked
 blend Normal
 texture fxpa_white
 birthrate 3
 lifeExp 1
 sizeStart 0.15
 sizeEnd 0.15
 colorStart 1 0 0
 colorEnd 1 0 0
 alphaStart 1
 alphaEnd 1
 lightningDelay 0
 lightningRadius 0
 lightningScale 0
 inherit_local 1
endnode
node reference endpoint
 parent bolt
 position 0 0 1
 refmodel fx_ref
 reattachable 1
endnode
endmodelgeom bw_2
donemodel bw_2
