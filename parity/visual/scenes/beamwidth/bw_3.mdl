# Authored beam blend discriminator; all geometry and emitter values equal.
newmodel bw_3
setsupermodel bw_3 NULL
classification Effects
setanimationscale 1
beginmodelgeom bw_3
node dummy bw_3
 parent NULL
endnode
node emitter bolt
 parent bw_3
 position 0 0 0
 update Lightning
 render Linked
 blend Normal
 texture fxpa_white
 birthrate 3
 lifeExp 1
 sizeStart 0.3
 sizeEnd 0.3
 colorStart 1 0 0
 colorEnd 1 0 0
 alphaStart 1
 alphaEnd 1
 lightningDelay 0
 lightningRadius 0
 lightningScale 0
 inherit_local 1
endnode
node reference endpoint
 parent bolt
 position 0 0 1
 refmodel fx_ref
 reattachable 1
endnode
endmodelgeom bw_3
donemodel bw_3
