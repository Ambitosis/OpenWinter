void main(){object pc=GetFirstPC();int n=GetLocalInt(OBJECT_SELF,"aborts")+1;SetLocalInt(OBJECT_SELF,"aborts",n);WriteTimestampedLogEntry("VISUAL|note|abort|number="+IntToString(n)+"|cancellerPC="+IntToString(GetLastPCToCancelCutscene()==pc)+"|event="+IntToString(GetCurrentlyRunningEvent(FALSE))+"|cutscene="+IntToString(GetCutsceneMode(pc))+"|plot="+IntToString(GetPlotFlag(pc)));if(GetLocalInt(OBJECT_SELF,"exit"))SetCutsceneMode(pc,FALSE);}
