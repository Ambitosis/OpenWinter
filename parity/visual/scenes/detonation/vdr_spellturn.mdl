newmodel vdr_spellturn
setsupermodel vdr_spellturn NULL
classification Effects
setanimationscale 1
beginmodelgeom vdr_spellturn
node dummy vdr_spellturn
 parent NULL
endnode
node emitter burst
 parent vdr_spellturn
 position -2 0 2
 update Explosion
 render Normal
 blend Normal
 texture fxpa_white
 birthrate 8
 lifeExp 3
 velocity 0.15
 sizeStart 0.18
