void main(){object s=GetPCChatSpeaker();WriteTimestampedLogEntry("VISUAL|note|chat|text="+GetPCChatMessage()+"|volume="+IntToString(GetPCChatVolume())+"|master="+IntToString(s==GetLocalObject(OBJECT_SELF,"master"))+"|familiar="+IntToString(s==GetLocalObject(OBJECT_SELF,"familiar"))+"|ispc="+IntToString(GetIsPC(s))+"|possessed="+IntToString(GetIsPossessedFamiliar(s))+"|name="+GetName(s)+"|player="+GetPCPlayerName(s));ExecuteScript("fc_edit",OBJECT_SELF);WriteTimestampedLogEntry("VISUAL|note|nested_return|text="+GetPCChatMessage()+"|volume="+IntToString(GetPCChatVolume())+"|event="+IntToString(GetCurrentlyRunningEvent())+"|direct="+IntToString(GetCurrentlyRunningEvent(FALSE)));if(GetPCChatMessage()=="MASTER_AFTER"){SetPCChatMessage("");WriteTimestampedLogEntry("VISUAL|note|suppressed|length="+IntToString(GetStringLength(GetPCChatMessage())));}}
