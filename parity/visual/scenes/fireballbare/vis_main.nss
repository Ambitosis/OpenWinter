#include "visual_inc"
#include "fpa_time"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Quiet(object o){int i;for(i=5000;i<=5012;i++)SetEventScript(o,i,"");SetCommandable(FALSE,o);SetPlotFlag(o,FALSE);SetIsDestroyable(FALSE,FALSE,FALSE,o);ApplyEffectToObject(DURATION_TYPE_PERMANENT,EffectTemporaryHitpoints(10000),o);}
void Cast(object pc,int step,float distance,int path){object target=GetLocalObject(GetModule(),"fpa_target_"+IntToString(step));SetLocalInt(GetModule(),"fpa_step",step);SetLocalFloat(GetModule(),"fpa_casttime",PNow());Note("cast."+IntToString(step)+".valid."+IntToString(GetIsObjectValid(target))+".seen."+IntToString(GetObjectSeen(target,pc))+".enemy."+IntToString(GetIsEnemy(target,pc))+".distance."+FloatToString(GetDistanceBetween(pc,target),0,3)+".path."+IntToString(path));AssignCommand(pc,ActionCastSpellAtObject(SPELL_FIREBALL,target,METAMAGIC_NONE,TRUE,path));}
void Spawn(object pc,int step,float distance){object target=VSpawn(pc,"nw_bandit001",distance,0.0,180.0);Quiet(target);ChangeToStandardFaction(target,STANDARD_FACTION_HOSTILE);SetIsTemporaryEnemy(target,pc);SetIsTemporaryEnemy(pc,target);SetLocalObject(GetModule(),"fpa_target_"+IntToString(step),target);}
void Direct(object pc){Note("play.valid."+IntToString(GetIsObjectValid(pc)));AssignCommand(pc,PlaySound("spr_fireball"));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;VBegin(pc);SetPlotFlag(pc,TRUE);SetLocalString(GetModule(),"X2_S_UD_SPELLSCRIPT","fpa_hit");Spawn(pc,0,3.0);Spawn(pc,1,20.0);object marker=VSpawn(pc,"nw_bandit001",-1.0,0.0,90.0);Quiet(marker);SetCommandable(TRUE,marker);SetPlotFlag(marker,TRUE);SetLocalObject(GetModule(),"fpa_marker",marker);DelayCommand(1.0,VCamera(pc,0.0,10.0,65.0));DelayCommand(9.0,Cast(pc,0,3.0,1));DelayCommand(18.0,Cast(pc,1,20.0,1));DelayCommand(11.5,VShot("near"));DelayCommand(21.0,VShot("far"));DelayCommand(27.0,Direct(pc));DelayCommand(32.0,VDone());}
