void main(){object item=GetPCItemLastEquipped();if(GetStringLeft(GetName(item),7)!="Ground ")return;object pc=GetItemPossessor(item);int n=GetLocalInt(GetModule(),"ORDER")+1;SetLocalInt(GetModule(),"ORDER",n);WriteTimestampedLogEntry("VISUAL|note|event|equip|"+GetName(item)+"|order="+IntToString(n)+"|owned="+IntToString(GetIsPC(pc))+"|right="+IntToString(GetItemInSlot(INVENTORY_SLOT_RIGHTHAND,pc)==item)+"|left="+IntToString(GetItemInSlot(INVENTORY_SLOT_LEFTHAND,pc)==item));}
