#include "visual_inc"
void Prepare(object pc,string rr,string name){AssignCommand(pc,ClearAllActions(TRUE));DestroyObject(GetLocalObject(pc,"item"));VMovePC(pc,20.0,15.0,0.0,90.0);object o=CreateObject(OBJECT_TYPE_ITEM,rr,Location(GetArea(pc),Vector(23.0,15.0,0.0),0.0));SetLocalObject(pc,"item",o);SetName(o,name);WriteTimestampedLogEntry("VISUAL|note|item|"+name+"|valid="+IntToString(GetIsObjectValid(o))+"|resref="+GetResRef(o)+"|base="+IntToString(GetBaseItemType(o)));}
void Ring(float t,string name){DelayCommand(t,WriteTimestampedLogEntry("VISUAL|hover|0.754,0.70"));DelayCommand(t+.3,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.70|down|right"));DelayCommand(t+1.0,VShot(name+"_root"));DelayCommand(t+1.4,WriteTimestampedLogEntry("VISUAL|hover|0.832,0.70"));DelayCommand(t+2.4,VShot(name+"_east"));DelayCommand(t+2.8,WriteTimestampedLogEntry("VISUAL|hover|0.676,0.70"));DelayCommand(t+3.8,VShot(name+"_west"));DelayCommand(t+4.2,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.70|up|right"));DelayCommand(t+4.5,WriteTimestampedLogEntry("VISUAL|key|101|tap"));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;WriteTimestampedLogEntry("VISUAL|note|character-fixture|"+GetName(pc)+"|pc="+IntToString(GetIsPC(pc)));WriteTimestampedLogEntry("VISUAL|note|profile|race="+IntToString(GetRacialType(pc))+"|wizard="+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,pc)));DelayCommand(.5,Prepare(pc,"nw_it_mpotion001","Potion"));DelayCommand(2.0,VCamera(pc,90.0,8.0,60.0));Ring(4.0,"potion");DelayCommand(10.0,Prepare(pc,"nw_ashsw001","Shield"));Ring(12.0,"shield");DelayCommand(18.0,VDone());}
