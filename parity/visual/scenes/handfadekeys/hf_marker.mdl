# Authored hand-phase discriminator; no game geometry copied.
newmodel hf_marker
setsupermodel hf_marker NULL
classification Effects
setanimationscale 1
beginmodelgeom hf_marker
node dummy hf_marker
 parent NULL
endnode
node emitter blue
 parent hf_marker
 position -0.3 0 0
 update Fountain
 render Normal
 blend Normal
 texture fxpa_white
 birthrate 80
 lifeExp 0.1
 velocity 0
 sizeStart 0.25
 sizeEnd 0.25
 colorStart 0 0 1
 colorEnd 0 0 1
 alphaStart 1
 alphaEnd 1
endnode
node emitter green
 parent hf_marker
 position 0.3 0 0
 update Fountain
 render Normal
 blend Normal
 texture fxpa_white
 birthrate 80
 lifeExp 0.1
 velocity 0
 sizeStart 0.25
 sizeEnd 0.25
 colorStart 0 1 0
 colorEnd 0 1 0
 alphaStart 1
 alphaEnd 1
endnode
endmodelgeom hf_marker
newanim conjure01 hf_marker
 length 0.5
 transtime 0
 animroot hf_marker
 node dummy hf_marker
  parent NULL
 endnode
 node emitter blue
  parent hf_marker
 endnode
 node emitter green
  parent hf_marker
  positionkey 6
   0 0.3 0 0
   0.1 0.3 0 0
   0.2 0.9 0 0
   0.3 0.9 0 0
   0.4 0.3 0 0
   0.5 0.3 0 0
 endnode
doneanim conjure01 hf_marker
newanim fade hf_marker
 length 2
 transtime 0
 animroot hf_marker
 node dummy hf_marker
  parent NULL
 endnode
 node emitter blue
  parent hf_marker
  birthratekey 1
   0 0
 endnode
 node emitter green
  parent hf_marker
  positionkey 1
   0 0 0 1
 endnode
doneanim fade hf_marker
donemodel hf_marker
