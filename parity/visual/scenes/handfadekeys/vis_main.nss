#include "hl_inc"
void CancelState(object pc){HNote("cancel.post_action",IntToString(GetCurrentAction(pc)));HNote("cancel.post_ready",IntToString(GetMemorizedSpellReady(pc,CLASS_TYPE_WIZARD,1,0)));}
void Start(object pc){string label=GetLocalInt(pc,"hf_second")?"cancel":"marker";SetLocalInt(pc,"hf_second",TRUE);SetLocalString(pc,"hl_case",label);SetMemorizedSpell(pc,CLASS_TYPE_WIZARD,1,0,102,TRUE);HNote(label+".slot",IntToString(GetMemorizedSpellId(pc,CLASS_TYPE_WIZARD,1,0)));HNote(label+".ready",IntToString(GetMemorizedSpellReady(pc,CLASS_TYPE_WIZARD,1,0)));HEvent(pc,"start");AssignCommand(pc,ActionCastSpellAtObject(102,pc,METAMAGIC_NONE,FALSE));AssignCommand(pc,ActionDoCommand(HAfter(pc)));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc)||GetLocalInt(GetModule(),"hl_started"))return;SetLocalInt(GetModule(),"hl_started",TRUE);int i;for(i=0;i<360;i++)DelayCommand(IntToFloat(i)/20.0,HClock(i));for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");SetPlotFlag(pc,TRUE);AssignCommand(pc,ClearAllActions(TRUE));HNote("identity",GetName(pc)+".pc."+IntToString(GetIsPC(pc))+".wizard."+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,pc))+".known."+IntToString(GetIsInKnownSpellList(pc,CLASS_TYPE_WIZARD,102)));HNote("table_conjure",Get2DAString("spells","ConjTime",102));HNote("table_recovery",Get2DAString("spells","CastTime",102));DelayCommand(1.0,VCamera(pc,270.0,7.0,65.0));DelayCommand(4.0,Start(pc));DelayCommand(4.15,VShot("positive_near"));DelayCommand(4.30,VShot("positive_far"));DelayCommand(4.45,VShot("positive_return"));DelayCommand(5.0,VShot("conjure"));DelayCommand(6.0,VShot("release"));DelayCommand(6.8,VShot("before_end"));DelayCommand(7.1,VShot("after010"));DelayCommand(7.4,VShot("after040"));DelayCommand(8.0,VShot("after100"));DelayCommand(9.0,VShot("after200"));DelayCommand(10.0,VShot("clear"));DelayCommand(12.0,Start(pc));DelayCommand(12.5,VShot("cancel_before"));DelayCommand(13.0,AssignCommand(pc,ClearAllActions(TRUE)));DelayCommand(13.1,CancelState(pc));DelayCommand(14.8,CancelState(pc));DelayCommand(13.15,VShot("cancel_after015"));DelayCommand(13.5,VShot("cancel_after050"));DelayCommand(14.2,VShot("cancel_clear"));DelayCommand(15.0,VDone());}
