#include "hp_inc"
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc)||GetLocalInt(GetModule(),"hp_started"))return;SetLocalInt(GetModule(),"hp_started",TRUE);SetLocalString(GetModule(),"X2_S_UD_SPELLSCRIPT","hp_hook");int i;for(i=0;i<220;i++)DelayCommand(IntToFloat(i)/20.0,HClock(i));for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");SetPlotFlag(pc,TRUE);SetAILevel(pc,AI_LEVEL_NORMAL);AssignCommand(pc,ClearAllActions(TRUE));HNote("identity",GetName(pc)+".pc."+IntToString(GetIsPC(pc))+".wizard."+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,pc))+".known."+IntToString(GetIsInKnownSpellList(pc,CLASS_TYPE_WIZARD,102)));DelayCommand(1.0,VCamera(pc,270.0,7.0,65.0));DelayCommand(4.0,HStart(pc,102,"remove_conjure",TRUE,0.5));DelayCommand(9.0,VDone());}
