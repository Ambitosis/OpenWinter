#include "hp_inc"
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc)||GetLocalInt(GetModule(),"hp_started"))return;SetLocalInt(GetModule(),"hp_started",TRUE);SetLocalString(GetModule(),"X2_S_UD_SPELLSCRIPT","hp_hook");int i;for(i=0;i<600;i++)DelayCommand(IntToFloat(i)/20.0,HClock(i));for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");SetPlotFlag(pc,TRUE);AssignCommand(pc,ClearAllActions(TRUE));HNote("identity",GetName(pc)+".pc."+IntToString(GetIsPC(pc))+".wizard."+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,pc))+".known."+IntToString(GetIsInKnownSpellList(pc,CLASS_TYPE_WIZARD,102)));DelayCommand(1.0,VCamera(pc,270.0,7.0,65.0));DelayCommand(4.0,HStart(pc,102,"add_remove",FALSE,0.5));DelayCommand(5.0,HSet(pc,FALSE));DelayCommand(12.0,HStart(pc,102,"remove_add",TRUE,0.5));DelayCommand(13.0,HSet(pc,TRUE));DelayCommand(20.0,HStart(pc,102,"add_late",FALSE,2.6));DelayCommand(26.0,VDone());}
