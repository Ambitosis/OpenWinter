#include "hl_inc"
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc)||GetLocalInt(GetModule(),"hl_started"))return;SetLocalInt(GetModule(),"hl_started",TRUE);int i;for(i=0;i<920;i++)DelayCommand(IntToFloat(i)/20.0,HClock(i));for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");SetPlotFlag(pc,TRUE);AssignCommand(pc,ClearAllActions(TRUE));HNote("identity",GetName(pc)+".pc."+IntToString(GetIsPC(pc))+".wizard."+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,pc))+".known."+IntToString(GetIsInKnownSpellList(pc,CLASS_TYPE_WIZARD,102)));HNote("table_conjure",Get2DAString("spells","ConjTime",102));HNote("table_recovery",Get2DAString("spells","CastTime",102));DelayCommand(1.0,VCamera(pc,270.0,7.0,65.0));DelayCommand(4.0,HStart(pc,"normal_flips",FALSE,FALSE));DelayCommand(17.0,HStart(pc,"fast_flips",TRUE,FALSE));DelayCommand(30.0,HStart(pc,"late_expiry",FALSE,TRUE));DelayCommand(42.0,VDone());}
