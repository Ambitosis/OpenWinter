# Wholly authored light fixture (no game assets): white point lights over the floor.
newmodel vdr_eleshield
setsupermodel vdr_eleshield NULL
classification Effects
setanimationscale 1
beginmodelgeom vdr_eleshield
node dummy vdr_eleshield
 parent NULL
endnode
node light testlight0
 parent vdr_eleshield
 position 0 0 1.0
 radius 2
 multiplier 1
 color 1 1 1
 isdynamic 1
 affectdynamic 1
 ambientonly 0
 lightpriority 5
 shadow 0
endnode
endmodelgeom vdr_eleshield
donemodel vdr_eleshield
