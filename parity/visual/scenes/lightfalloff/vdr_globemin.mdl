# Wholly authored light fixture (no game assets): white point lights over the floor.
newmodel vdr_globemin
setsupermodel vdr_globemin NULL
classification Effects
setanimationscale 1
beginmodelgeom vdr_globemin
node dummy vdr_globemin
 parent NULL
endnode
node light testlight0
 parent vdr_globemin
 position 0 0 2.5
 radius 4
 multiplier 1
 color 1 1 1
 isdynamic 1
 affectdynamic 1
 ambientonly 0
 lightpriority 5
 shadow 0
endnode
endmodelgeom vdr_globemin
donemodel vdr_globemin
