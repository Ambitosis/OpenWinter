# Wholly authored light-controller fixture; no game assets.
newmodel vdr_spellturn
setsupermodel vdr_spellturn NULL
classification Effects
setanimationscale 1
beginmodelgeom vdr_spellturn
node dummy vdr_spellturn
 parent NULL
endnode
node light testlight
 parent vdr_spellturn
 position 0 0 0.5
 radius 2
 multiplier 1
 color 1 1 1
 isdynamic 1
 affectdynamic 1
 shadow 0
endnode
endmodelgeom vdr_spellturn
newanim impact vdr_spellturn
 length 11
 transtime 0
 animroot vdr_spellturn
 node light testlight
  parent vdr_spellturn
  radiuskey 6
   0 2
   1 2
   2 8
   3 8
   4 2
   11 2
  colorkey 4
   0 1 1 1
   5 1 1 1
   6 1 0 0
   11 1 0 0
  multiplierkey 4
   0 1
   7 1
   8 0
   11 0
 endnode
 doneanim impact vdr_spellturn
donemodel vdr_spellturn
