# Linked emitters (OpenWinter parity lab, scene linkedarea, MIT licence): measured on both engines.
# area: born over 4 x 2 m; point: a rising ribbon with a ring texture; pointgrid: the same with a 2x2 symbol sheet;
# level: moving east; areagrid: born over 4 x 2 m with a 4x4 smoke flipbook.
newmodel vdr_spellturn
setsupermodel vdr_spellturn NULL
classification Effects
setanimationscale 1
beginmodelgeom vdr_spellturn
node dummy vdr_spellturn
  parent NULL
endnode
node emitter area
  parent vdr_spellturn
  position 0 -6 0.3
  orientation 0 0 0 0
  update Fountain
  render Linked
