void main(){object pc=GetFirstPC();string phase=GetLocalString(GetModule(),"phase");WriteTimestampedLogEntry("VISUAL|note|dialog|phase="+phase+"|tag="+GetTag(OBJECT_SELF)+"|event="+IntToString(GetCurrentlyRunningEvent(FALSE))+"|speaker="+IntToString(GetLastSpeaker()==pc)+"|pcspeaker="+IntToString(GetPCSpeaker()==pc)+"|inconversation="+IntToString(IsInConversation(pc)));SetLocalInt(OBJECT_SELF,"dialogs",GetLocalInt(OBJECT_SELF,"dialogs")+1);}
