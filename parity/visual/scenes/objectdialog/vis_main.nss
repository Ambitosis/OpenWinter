#include "visual_inc"
void State(string phase){object p=GetObjectByTag("PLC"),d=GetObjectByTag("DOOR"),pc=GetFirstPC();WriteTimestampedLogEntry("VISUAL|note|state|phase="+phase+"|pc="+IntToString(GetIsPC(pc))+"|plc="+IntToString(GetIsObjectValid(p))+"|door="+IntToString(GetIsObjectValid(d))+"|plcDialogs="+IntToString(GetLocalInt(p,"dialogs"))+"|doorDialogs="+IntToString(GetLocalInt(d,"dialogs"))+"|action="+IntToString(GetCurrentAction(pc)));}
void Act(string phase,string tag,string dlg,int use=FALSE){object pc=GetFirstPC();SetLocalString(GetModule(),"phase",phase);AssignCommand(pc,ClearAllActions(TRUE));AssignCommand(pc,JumpToLocation(Location(GetArea(pc),Vector(20.0,20.0,0.0),90.0)));if(use)AssignCommand(pc,ActionInteractObject(GetObjectByTag(tag)));else AssignCommand(pc,ActionStartConversation(GetObjectByTag(tag),dlg,FALSE,FALSE));}
void main(){object pc=GetFirstPC();object p=CreateObject(OBJECT_TYPE_PLACEABLE,"plc_chair",Location(GetArea(pc),Vector(22.0,20.0,0.0),0.0),FALSE,"PLC");object d=GetObjectByTag("DOOR");SetEventScript(p,EVENT_SCRIPT_PLACEABLE_ON_DIALOGUE,"od_dialog");SetEventScript(d,EVENT_SCRIPT_DOOR_ON_DIALOGUE,"od_dialog");SetEventScript(p,EVENT_SCRIPT_PLACEABLE_ON_USED,"od_used");SetUseableFlag(p,TRUE);State("setup");DelayCommand(1.0,Act("plc_default","PLC",""));DelayCommand(2.5,State("plc_default"));DelayCommand(3.0,Act("plc_explicit","PLC","od_empty"));DelayCommand(4.5,State("plc_explicit"));DelayCommand(5.0,Act("door_default","DOOR",""));DelayCommand(6.5,State("door_default"));DelayCommand(7.0,Act("door_explicit","DOOR","od_empty"));DelayCommand(8.5,State("door_explicit"));DelayCommand(9.0,Act("plc_use","PLC","",TRUE));DelayCommand(10.5,State("plc_use"));DelayCommand(11.0,VDone());}
