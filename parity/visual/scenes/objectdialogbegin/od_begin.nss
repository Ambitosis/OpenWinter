void main(){object pc=GetFirstPC();WriteTimestampedLogEntry("VISUAL|note|before|pc="+IntToString(GetIsPC(pc))+"|speakerValid="+IntToString(GetIsObjectValid(GetLastSpeaker()))+"|pcspeakerValid="+IntToString(GetIsObjectValid(GetPCSpeaker()))+"|usedPC="+IntToString(GetLastUsedBy()==pc)+"|clickPC="+IntToString(GetClickingObject()==pc));int first=BeginConversation();WriteTimestampedLogEntry("VISUAL|note|begin_default|result="+IntToString(first)+"|conversation="+IntToString(IsInConversation(pc)));if(!first){int second=BeginConversation("od_line");WriteTimestampedLogEntry("VISUAL|note|begin_explicit|result="+IntToString(second)+"|conversation="+IntToString(IsInConversation(pc))+"|pcspeaker="+IntToString(GetPCSpeaker()==pc));}}
