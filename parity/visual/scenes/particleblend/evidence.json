    "change": "diff --git a/client/Rendering/Emitters/AuroraEmitter.cs b/client/Rendering/Emitters/AuroraEmitter.cs\nindex 02b26f5..511c69b 100644\n--- a/client/Rendering/Emitters/AuroraEmitter.cs\n+++ b/client/Rendering/Emitters/AuroraEmitter.cs\n@@ -256,9 +256,12 @@ public partial class AuroraEmitter : Node3D\n         m.SetShaderParameter(\"gravity\", e.Mass * Gravity);\n         m.SetShaderParameter(\"drag\", Math.Max(0, e.Drag));\n         float g = Gamma(e);\n-        m.SetShaderParameter(\"col_start\", Linear(e.ColorStart, e.AlphaStart, g));\n-        m.SetShaderParameter(\"col_end\", Linear(e.ColorEnd, e.AlphaEnd, g));\n-        m.SetShaderParameter(\"col_mid\", Linear(e.ColorMid, e.AlphaMid, g));\n+        var startColor = Linear(e.ColorStart, e.AlphaStart, g);\n+        m.SetShaderParameter(\"col_start\", new Vector4(startColor.R, startColor.G, startColor.B, startColor.A));\n+        var endColor = Linear(e.ColorEnd, e.AlphaEnd, g);\n+        m.SetShaderParameter(\"col_end\", new Vector4(endColor.R, endColor.G, endColor.B, endColor.A));\n+        var midColor = Linear(e.ColorMid, e.AlphaMid, g);\n+        m.SetShaderParameter(\"col_mid\", new Vector4(midColor.R, midColor.G, midColor.B, midColor.A));\n         bool hasY = e.SizeStartY != 0 || e.SizeEndY != 0;\n         m.SetShaderParameter(\"size_start\", new Vector2(e.SizeStart, hasY ? e.SizeStartY : e.SizeStart));\n         m.SetShaderParameter(\"size_end\", new Vector2(e.SizeEnd, hasY ? e.SizeEndY : e.SizeEnd));\n",
