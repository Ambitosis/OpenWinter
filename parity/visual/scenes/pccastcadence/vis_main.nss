#include "visual_inc"
#include "cadclock_inc"
void Quiet(object c){int i;for(i=5000;i<=5012;i++)SetEventScript(c,i,"");SetAILevel(c,AI_LEVEL_NORMAL);SetPlotFlag(c,TRUE);SetSoundset(c,65535);AssignCommand(c,ClearAllActions(TRUE));}
void Restore(object c){SetMemorizedSpell(c,CLASS_TYPE_WIZARD,1,0,102,TRUE);}
void After(object c,int n){Event(c,"after"+IntToString(n));Note(GetLocalString(c,"cad_key")+"."+GetLocalString(c,"cad_phase")+".spent"+IntToString(n),IntToString(!GetMemorizedSpellReady(c,CLASS_TYPE_WIZARD,1,0)));Restore(c);}
void Cast(object c){AssignCommand(c,ActionCastSpellAtObject(102,c,METAMAGIC_NONE,FALSE));}
void Prep(object c,string phase){SetLocalString(c,"cad_phase",phase);SetLocalInt(c,"cad_impacts",0);SetLocalInt(c,"cad_swings",0);Restore(c);Event(c,"start");Note(GetLocalString(c,"cad_key")+"."+phase+".slot",IntToString(GetMemorizedSpellId(c,CLASS_TYPE_WIZARD,1,0)));}
void Three(object c,string phase,int haste){Prep(c,phase);if(haste)ApplyEffectToObject(DURATION_TYPE_PERMANENT,EffectHaste(),c);int i;for(i=0;i<3;i++){Cast(c);AssignCommand(c,ActionDoCommand(After(c,i)));}}
void Clean(object c){AssignCommand(c,ClearAllActions(TRUE));effect e=GetFirstEffect(c);while(GetIsEffectValid(e)){if(GetEffectType(e)==EFFECT_TYPE_HASTE)RemoveEffect(c,e);e=GetNextEffect(c);}}
void Switch(object c){Event(c,"switch");Note(GetLocalString(c,"cad_key")+"."+GetLocalString(c,"cad_phase")+".swung",IntToString(GetLocalInt(c,"cad_swings")>0));AssignCommand(c,ClearAllActions(TRUE));Cast(c);AssignCommand(c,ActionDoCommand(After(c,0)));}
void AttackThenCast(object c,int apr){Prep(c,"attack"+IntToString(apr));SetBaseAttackBonus(apr,c);Note(GetLocalString(c,"cad_key")+".apr"+IntToString(apr),IntToString(GetAttacksPerRound(c)));AssignCommand(c,ActionAttack(GetLocalObject(c,"cad_target")));DelayCommand(1.0,Switch(c));}
void MakeTarget(object c){object t=CreateObject(OBJECT_TYPE_CREATURE,"nw_bandit001",Location(GetArea(c),GetPosition(c)+Vector(1.5,0.0,0.0),180.0));Quiet(t);SetCommandable(FALSE,t);SetEventScript(t,EVENT_SCRIPT_CREATURE_ON_MELEE_ATTACKED,"cad_swing");SetLocalObject(c,"cad_target",t);SetIsTemporaryEnemy(c,t);SetIsTemporaryEnemy(t,c);ApplyEffectToObject(DURATION_TYPE_PERMANENT,EffectSkillIncrease(SKILL_CONCENTRATION,50),c);SetActionMode(c,ACTION_MODE_DEFENSIVE_CAST,TRUE);}
void Actor(object c,string key){Quiet(c);SetLocalString(c,"cad_key",key);Note(key+".identity",GetName(c)+".pc."+IntToString(GetIsPC(c))+".wizard."+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,c))+".known."+IntToString(GetIsInKnownSpellList(c,CLASS_TYPE_WIZARD,102)));DelayCommand(38.0,MakeTarget(c));
 DelayCommand(4.0,Three(c,"normal",FALSE));DelayCommand(22.0,Clean(c));DelayCommand(26.0,Three(c,"haste",TRUE));DelayCommand(37.0,Clean(c));DelayCommand(42.0,AttackThenCast(c,1));DelayCommand(56.0,AttackThenCast(c,2));DelayCommand(70.0,AttackThenCast(c,6));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc)||GetLocalInt(GetModule(),"cad_started"))return;SetLocalInt(GetModule(),"cad_started",1);ClockStart();object clone=CopyObject(pc,Location(GetArea(pc),Vector(25.0,14.0,0.0),90.0),OBJECT_INVALID,"cad_copy");Actor(pc,"pc");Actor(clone,"copy");DelayCommand(1.0,VCamera(pc,90.0,10.0,70.0));DelayCommand(5.0,VShot("normal"));DelayCommand(27.0,VShot("haste"));DelayCommand(72.0,VShot("attack_six"));DelayCommand(85.0,VDone());}
