#include "visual_inc"
float Now(){return IntToFloat((GetTimeHour()*(FloatToInt(HoursToSeconds(1))/60)+GetTimeMinute())*60+GetTimeSecond())+IntToFloat(GetTimeMillisecond())/1000.0;}
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void DoneUse(object c,int n){Note(GetLocalString(c,"case")+".done."+IntToString(n)+".time."+FloatToString(Now()-GetLocalFloat(c,"start"),0,3)+".stack."+IntToString(GetItemStackSize(GetLocalObject(c,"pot"))));}
void Use(object c,int n){object p=GetLocalObject(c,"pot");AssignCommand(c,ActionUseItemOnObject(p,GetFirstItemProperty(p),c));AssignCommand(c,ActionDoCommand(DoneUse(c,n)));}
void Poll(object c,int previous,int n){int stack=GetItemStackSize(GetLocalObject(c,"pot"));if(stack!=previous)Note(GetLocalString(c,"case")+".stack."+IntToString(stack)+".time."+FloatToString(Now()-GetLocalFloat(c,"start"),0,3));if(n<200)DelayCommand(0.05,Poll(c,stack,n+1));}
void Clear(object c){Note("clear");AssignCommand(c,ClearAllActions(TRUE));Use(c,9);}
void Begin(object pc,int phase){AssignCommand(pc,ClearAllActions(TRUE));object p;if(phase==0){p=GetFirstItemInInventory(pc);while(GetIsObjectValid(p)&&(GetBaseItemType(p)!=49||GetItemPropertySubType(GetFirstItemProperty(p))!=66))p=GetNextItemInInventory(pc);SetItemStackSize(p,3);}else p=CreateItemOnObject("nw_it_mpotion001",pc,3);SetLocalObject(pc,"pot",p);SetLocalString(pc,"case","phase"+IntToString(phase));SetLocalFloat(pc,"start",Now());Note("start."+IntToString(phase)+".pc."+IntToString(GetIsPC(pc))+".base."+IntToString(GetBaseItemType(p))+".stack."+IntToString(GetItemStackSize(p)));Use(pc,1);Use(pc,2);Use(pc,3);Poll(pc,3,0);if(phase==1)DelayCommand(0.7,Clear(pc));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;VBegin(pc);DelayCommand(1.0,VCamera(pc,90.0,5.0,65.0));DelayCommand(3.0,Begin(pc,0));DelayCommand(3.2,VShot("drink_start"));DelayCommand(4.0,VShot("drink_middle"));DelayCommand(4.8,VShot("drink_release"));DelayCommand(5.5,VShot("drink_finish"));DelayCommand(9.0,VShot("third"));DelayCommand(14.0,Begin(pc,1));DelayCommand(15.0,VShot("after_clear"));DelayCommand(23.0,VShot("end"));DelayCommand(25.0,VDone());}
