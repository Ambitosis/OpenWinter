#include "visual_inc"
void Report(object pc,string phase) {object o=GetObjectByTag("RL_CHEST");vector v=GetPosition(pc);WriteTimestampedLogEntry("VISUAL|note|"+phase+"|locked="+IntToString(GetLocked(o))+"|lockable="+IntToString(GetLockLockable(o))+"|skill="+IntToString(GetSkillRank(SKILL_OPEN_LOCK,pc,TRUE))+"|action="+IntToString(GetCurrentAction(pc))+"|x="+FloatToString(v.x)+"|y="+FloatToString(v.y));}
void Setup(object pc) {object o=VPlaceable(pc,"plc_chest1",3.0,0.0);SetTag(o,"RL_CHEST");SetLocked(o,FALSE);SetLockLockable(o,TRUE);SetLockLockDC(o,0);Report(pc,"setup");}
void Key(object pc) {object o=GetObjectByTag("RL_CHEST");AssignCommand(pc,ClearAllActions(TRUE));AssignCommand(pc,JumpToLocation(Location(GetArea(pc),Vector(20.0,15.0,0.0),90.0)));SetLocked(o,TRUE);SetLockKeyRequired(o,TRUE);SetLockKeyTag(o,"RL_KEY");object key=CreateItemOnObject("nw_it_mpotion001",pc);SetTag(key,"RL_KEY");Report(pc,"key");}
void Door() {object o=GetObjectByTag("RL_DOOR");SetLockLockable(o,TRUE);SetLocked(o,FALSE);SetLockLockDC(o,0);}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;
 DelayCommand(1.0,Setup(pc));DelayCommand(2.0,VCamera(pc,90.0,8.0,60.0));DelayCommand(3.0,VShot("a_world"));
 DelayCommand(4.0,WriteTimestampedLogEntry("VISUAL|hover|0.754,0.63"));DelayCommand(4.3,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.63|down|right"));DelayCommand(5.2,VShot("b_lockable"));DelayCommand(6.0,WriteTimestampedLogEntry("VISUAL|key|100|tap"));
 DelayCommand(6.3,Report(pc,"lock_6.3"));DelayCommand(7.0,Report(pc,"lock_7"));DelayCommand(8.0,Report(pc,"lock_8"));DelayCommand(9.0,Report(pc,"lock_9"));DelayCommand(9.5,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.63|up|right"));
 DelayCommand(10.0,Key(pc));DelayCommand(11.0,VCamera(pc,90.0,8.0,60.0));DelayCommand(12.0,WriteTimestampedLogEntry("VISUAL|hover|0.754,0.63"));DelayCommand(12.3,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.63|down|right"));DelayCommand(13.2,VShot("c_has_key"));DelayCommand(14.0,WriteTimestampedLogEntry("VISUAL|key|100|tap"));
 DelayCommand(14.3,Report(pc,"key_14.3"));DelayCommand(15.0,Report(pc,"key_15"));DelayCommand(16.0,Report(pc,"key_16"));DelayCommand(17.0,Report(pc,"key_17"));DelayCommand(17.5,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.63|up|right"));
 DelayCommand(18.0,Door());DelayCommand(18.2,AssignCommand(pc,JumpToLocation(Location(GetArea(pc),Vector(20.0,15.0,0.0),90.0))));DelayCommand(19.0,VCamera(pc,90.0,8.0,60.0));DelayCommand(20.0,WriteTimestampedLogEntry("VISUAL|hover|0.50,0.40"));DelayCommand(20.3,WriteTimestampedLogEntry("VISUAL|mouse|0.50,0.40|down|right"));DelayCommand(21.2,VShot("d_lockable_door"));DelayCommand(22.0,WriteTimestampedLogEntry("VISUAL|mouse|0.50,0.40|up|right"));DelayCommand(24.0,VDone());}
