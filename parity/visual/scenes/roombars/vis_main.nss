#include "visual_inc"
void Note(string name){object pc=GetFirstPC();object n=GetObjectByTag("probe_npc");object d=GetNearestObjectToLocation(OBJECT_TYPE_DOOR,Location(GetArea(pc),Vector(15.0,60.0,0.0),0.0));vector p=GetPosition(pc);vector q=GetPosition(n);WriteTimestampedLogEntry("VISUAL|note|bars|"+name+"|pc="+FloatToString(p.x)+","+FloatToString(p.y)+"|npc="+FloatToString(q.x)+","+FloatToString(q.y)+"|open="+IntToString(GetIsOpen(d))+"|los="+IntToString(LineOfSightObject(pc,n))+"|seen="+IntToString(GetObjectSeen(n,pc))+"|heard="+IntToString(GetObjectHeard(n,pc))+"|reverseSeen="+IntToString(GetObjectSeen(pc,n))+"|reverseHeard="+IntToString(GetObjectHeard(pc,n))+"|explored="+IntToString(GetTileExplored(pc,GetArea(pc),1,6)));VShot(name);}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;SetCameraMode(pc,CAMERA_MODE_TOP_DOWN);SetCameraLimits(pc,1.0,89.0,1.0,40.0);SetPlotFlag(pc,TRUE);object d=GetNearestObjectToLocation(OBJECT_TYPE_DOOR,Location(GetArea(pc),Vector(15.0,60.0,0.0),0.0));SetLocked(d,FALSE);object n=VSpawn(pc,"nw_bandit001",0.0,6.0,270.0);SetTag(n,"probe_npc");SetAILevel(n,AI_LEVEL_NORMAL);ApplyEffectToObject(DURATION_TYPE_PERMANENT,EffectCutsceneParalyze(),n);DelayCommand(2.0,VCamera(pc,90.0,15.0,35.0));DelayCommand(6.0,Note("a_closed"));DelayCommand(9.0,AssignCommand(d,ActionOpenDoor(d)));DelayCommand(14.0,Note("b_open"));DelayCommand(17.0,AssignCommand(d,ActionCloseDoor(d)));DelayCommand(22.0,Note("c_closed_again"));DelayCommand(25.0,VDone());}
