#include "visual_inc"
void Note(string k,string v){WriteTimestampedLogEntry("VISUAL|note|"+k+"|"+v);}
void Direct(object pc){ReplaceObjectAnimation(pc,"pause1","castselflp");AssignCommand(pc,ActionPlayAnimation(ANIMATION_LOOPING_PAUSE,1.0,3.0));DelayCommand(.5,VShot("direct_050"));DelayCommand(1.5,VShot("direct_150"));DelayCommand(2.5,VShot("direct_250"));}
void Spell(object pc){ReplaceObjectAnimation(pc,"pause1","");SetLocalString(pc,"sc_case","ordinary");SetMemorizedSpell(pc,CLASS_TYPE_WIZARD,1,0,SPELL_MAGE_ARMOR,TRUE);Note("slot",IntToString(GetMemorizedSpellId(pc,CLASS_TYPE_WIZARD,1,0)));Note("ready",IntToString(GetMemorizedSpellReady(pc,CLASS_TYPE_WIZARD,1,0)));AssignCommand(pc,ActionCastSpellAtObject(SPELL_MAGE_ARMOR,pc,METAMAGIC_NONE,FALSE));DelayCommand(2.1,VShot("cast_210"));DelayCommand(2.5,VShot("cast_250"));DelayCommand(2.9,VShot("cast_290"));DelayCommand(3.5,VShot("cast_clear"));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc)||GetLocalInt(GetModule(),"sp_started"))return;SetLocalInt(GetModule(),"sp_started",TRUE);SetLocalString(GetModule(),"X2_S_UD_SPELLSCRIPT","sc_hook");Note("identity",GetName(pc)+".pc."+IntToString(GetIsPC(pc))+".wizard."+IntToString(GetLevelByClass(CLASS_TYPE_WIZARD,pc)));int i;for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");SetPlotFlag(pc,TRUE);SetAILevel(pc,AI_LEVEL_NORMAL);AssignCommand(pc,ClearAllActions(TRUE));DelayCommand(1.0,VCamera(pc,270.0,5.0,65.0));DelayCommand(2.0,VShot("baseline"));DelayCommand(3.0,Direct(pc));DelayCommand(8.0,Spell(pc));DelayCommand(13.0,VDone());}
