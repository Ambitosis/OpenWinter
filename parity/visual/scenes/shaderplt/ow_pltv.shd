// Visual scene "shaderplt" (part of OpenWinter, MIT licence): passes the vertex in its mesh's space (vPos) on.
#define SHADER_TYPE 1
#define FOG 0
#define KEYHOLING 0
#define NORMAL_MAP 0
#define ENVIRONMENT_MAP 0
#define LIGHTING 0

#include "inc_standard"

varying vec3 vOwMesh;

void main()
{
    ApplyStandardShader();
    vOwMesh = vPos.xyz;
}
