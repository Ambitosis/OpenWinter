// Visual scene "shaders" (part of OpenWinter, MIT licence): the ground texture under world-aligned bands that
// a script controls through the SetShaderUniform* banks.
//   scriptableFloat1  how strongly the bands are tinted (0: the plain ground)
//   scriptableVec1    the tint colour
//   scriptableInt1    0: bands along y (alternating in x), 1: a checkerboard
//   bandWidth         band width in metres (a material parameter, set in ttr01_grass02.mtr)
#define SHADER_TYPE 2
#define FOG 1
#define KEYHOLING 1
#define LIGHTING 1
#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"
#include "inc_scriptable"

uniform float bandWidth;

float Band(vec3 vWorld)
{
    float fWidth = max(bandWidth, 0.25);
    float fCell = floor(vWorld.x / fWidth);
    if (scriptableInt1 == 1)
        fCell += floor(vWorld.y / fWidth);
    return mod(fCell, 2.0);
}

void main()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();
    vec3 vWorld = (m_view_inv * vec4(vPosView, 1.0)).xyz;
    float fBand = Band(vWorld) * clamp(scriptableFloat1, 0.0, 1.0);
    FragmentColor.rgb = mix(FragmentColor.rgb, ApplyColorSpace(scriptableVec1.rgb), fBand);
    ApplyStandardShader();
    gl_FragColor = FragmentColor;
}
