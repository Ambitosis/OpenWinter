void main(){object pc=GetModuleItemAcquiredBy();object item=GetModuleItemAcquired();if(!GetIsPC(pc))return;string tag=GetTag(item);if(tag=="VOICEPICKUP")SetLocalInt(pc,"pickup_acquired",GetLocalInt(pc,"pickup_acquired")+1);WriteTimestampedLogEntry("VISUAL|note|encumbered.acquire.pc."+IntToString(GetIsPC(pc))+".tag."+tag+".stack."+IntToString(GetItemStackSize(item))+".itemweight."+IntToString(GetWeight(item))+".pcweight."+IntToString(GetWeight(pc)));}
