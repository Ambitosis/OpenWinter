#include "visual_inc"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Quiet(object pc){int i;for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");AssignCommand(pc,ClearAllActions(TRUE));}
void Positive(object pc){Note("encumbered.positive.slot.32");PlayVoiceChat(VOICE_CHAT_ENCUMBERED,pc);}
void Remember(object pc,object item){int n=GetLocalInt(pc,"load_count");SetLocalObject(pc,"load_"+IntToString(n),item);SetLocalInt(pc,"load_count",n+1);}
void State(object pc,string phase,int expected){int weight=GetWeight(pc);int normal=GetLocalInt(pc,"normal");int heavy=GetLocalInt(pc,"heavy");int state=weight>heavy?2:weight>normal?1:0;Note("encumbered.state."+phase+".weight."+IntToString(weight)+".normal."+IntToString(normal)+".heavy."+IntToString(heavy)+".derived."+IntToString(state)+".expected."+IntToString(expected)+".str."+IntToString(GetAbilityScore(pc,ABILITY_STRENGTH)));if(expected>=0&&weight!=expected)Note("INVALID_WEIGHT_CONTEXT");}
void Load(object pc,string phase,int count){Note("encumbered.load."+phase+".before."+IntToString(GetWeight(pc))+".darts."+IntToString(count));int i;int remaining=count;while(remaining>0&&i<80){int n=remaining>50?50:remaining;object item=CreateItemOnObject("nw_wthdt001",pc,n,"VOICELOAD");Remember(pc,item);if(!GetIsObjectValid(item))Note("INVALID_LOAD_ITEM");remaining-=n;i++;}if(remaining!=0)Note("INVALID_LOAD_LIMIT");}
void Unload(object pc,string phase){Note("encumbered.unload."+phase+".before."+IntToString(GetWeight(pc)));int n=GetLocalInt(pc,"load_count");int i;for(i=0;i<n;i++){object item=GetLocalObject(pc,"load_"+IntToString(i));if(GetIsObjectValid(item))DestroyObject(item);}SetLocalInt(pc,"load_count",0);}
void Pickup(object pc){object item=CreateObject(OBJECT_TYPE_ITEM,"nw_wswls001",Location(GetArea(pc),Vector(21.0,15.0,0.0),0.0));SetTag(item,"VOICEPICKUP");Remember(pc,item);SetLocalObject(pc,"pickup",item);int weight=GetWeight(item);Note("encumbered.pickup.item.valid."+IntToString(GetIsObjectValid(item))+".weight."+IntToString(weight)+".possessorInvalid."+IntToString(GetItemPossessor(item)==OBJECT_INVALID));if(weight!=40||weight+GetWeight(pc)<=GetLocalInt(pc,"normal")||weight+GetWeight(pc)>GetLocalInt(pc,"heavy"))Note("INVALID_PICKUP_WEIGHT");AssignCommand(pc,ActionPickUpItem(item));}
void PickupState(object pc){object item=GetLocalObject(pc,"pickup");Note("encumbered.pickup.complete.valid."+IntToString(GetIsObjectValid(item))+".owned."+IntToString(GetItemPossessor(item)==pc)+".weight."+IntToString(GetWeight(pc))+".acquire."+IntToString(GetLocalInt(pc,"pickup_acquired")));if(GetItemPossessor(item)!=pc||GetLocalInt(pc,"pickup_acquired")!=1)Note("INVALID_PICKUP_CONTEXT");}
void Gate(object pc){int strength=GetAbilityScore(pc,ABILITY_STRENGTH);int normal=StringToInt(Get2DAString("encumbrance","Normal",strength));int heavy=StringToInt(Get2DAString("encumbrance","Heavy",strength));int base=GetWeight(pc);SetLocalInt(pc,"normal",normal);SetLocalInt(pc,"heavy",heavy);SetLocalInt(pc,"base",base);int dartweight=StringToInt(Get2DAString("baseitems","TenthLBS",31));int dartstack=StringToInt(Get2DAString("baseitems","Stacking",31));int valid=dartweight==1&&dartstack==50&&GetIsPC(pc)&&GetName(pc)=="Aluvian Darkstar"&&GetSoundset(pc)==5100&&base<normal&&normal<heavy&&heavy-base<3900;Note("encumbered.ready."+IntToString(valid)+".pc."+IntToString(GetIsPC(pc))+".name."+GetName(pc)+".soundset."+IntToString(GetSoundset(pc))+".str."+IntToString(strength)+".base."+IntToString(base)+".normal."+IntToString(normal)+".heavy."+IntToString(heavy)+".dartweight."+IntToString(dartweight)+".dartstack."+IntToString(dartstack));if(!valid){Note("INVALID_PC_CONTEXT");VDone();return;}
DelayCommand(2.0,Load(pc,"normal",normal-base));DelayCommand(2.5,State(pc,"normal",normal));DelayCommand(3.0,VShot("normal"));
DelayCommand(5.0,Load(pc,"crossnormal",1));DelayCommand(5.5,State(pc,"crossnormal",normal+1));DelayCommand(6.0,VShot("encumbered"));
DelayCommand(11.0,Load(pc,"remain",10));DelayCommand(11.5,State(pc,"remain",normal+11));
DelayCommand(17.0,Unload(pc,"reset1"));DelayCommand(17.5,State(pc,"reset1",base));
DelayCommand(23.0,Load(pc,"crossheavy",heavy+1-base));DelayCommand(23.5,State(pc,"crossheavy",heavy+1));DelayCommand(24.0,VShot("overloaded"));
DelayCommand(31.0,Unload(pc,"reset2"));DelayCommand(31.5,State(pc,"reset2",base));
DelayCommand(37.0,Load(pc,"prepickup",normal-20-base));DelayCommand(37.5,State(pc,"prepickup",normal-20));
DelayCommand(39.0,Pickup(pc));DelayCommand(42.0,PickupState(pc));DelayCommand(42.2,State(pc,"pickup",normal+20));DelayCommand(42.5,VShot("pickedup"));
DelayCommand(47.0,Unload(pc,"reset3"));DelayCommand(47.5,State(pc,"reset3",base));
DelayCommand(53.0,Load(pc,"recross",normal+1-base));DelayCommand(53.5,State(pc,"recross",normal+1));
DelayCommand(60.0,Positive(pc));DelayCommand(62.0,Note("encumbered.completed"));DelayCommand(63.0,VDone());}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;Quiet(pc);SetPlotFlag(pc,TRUE);SetSoundset(pc,5100);SetEventScript(GetModule(),EVENT_SCRIPT_MODULE_ON_ACQUIRE_ITEM,"vis_acquire");DelayCommand(1.0,VCamera(pc,90.0,7.0,65.0));DelayCommand(2.0,Positive(pc));DelayCommand(4.0,Gate(pc));}
