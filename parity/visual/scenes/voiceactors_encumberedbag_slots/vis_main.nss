#include "visual_inc"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Positive(object pc){Note("encumbered.positive.slot.32");PlayVoiceChat(VOICE_CHAT_ENCUMBERED,pc);}
void State(object pc,string phase,int state){int w=GetWeight(pc);int n=GetLocalInt(pc,"normal");int h=GetLocalInt(pc,"heavy");int actual=w>h?2:w>n?1:0;Note("encumberedbag.state."+phase+".weight."+IntToString(w)+".normal."+IntToString(n)+".heavy."+IntToString(h)+".derived."+IntToString(actual)+".expected."+IntToString(state));if(actual!=state)Note("INVALID_WEIGHT_CONTEXT");}
void MakeBag(object pc,int shields){object bag=CreateObject(OBJECT_TYPE_ITEM,"nw_it_contain001",Location(GetArea(pc),Vector(21.0,15.0,0.0),0.0));int i;for(i=0;i<shields;i++)CreateItemOnObject("nw_ashto001",bag);SetLocalObject(pc,"bag",bag);int w=GetWeight(bag);int n=GetLocalInt(pc,"normal");int h=GetLocalInt(pc,"heavy");Note("encumberedbag.prepare.shields."+IntToString(shields)+".valid."+IntToString(GetIsObjectValid(bag))+".weight."+IntToString(w)+".possessorInvalid."+IntToString(GetItemPossessor(bag)==OBJECT_INVALID));if(!GetIsObjectValid(bag)||w<=0||GetItemPossessor(bag)!=OBJECT_INVALID||(shields==3&&w+GetWeight(pc)<=h)||(shields==2&&(w+GetWeight(pc)<=n||w+GetWeight(pc)>h)))Note("INVALID_BAG_CONTEXT");}
void Pick(object pc,int n){object bag=GetLocalObject(pc,"bag");Note("encumberedbag.pickup."+IntToString(n)+".before."+IntToString(GetWeight(pc)));AssignCommand(pc,ActionPickUpItem(bag));}
void Owned(object pc){object bag=GetLocalObject(pc,"bag");Note("encumberedbag.owned."+IntToString(GetItemPossessor(bag)==pc));if(GetItemPossessor(bag)!=pc)Note("INVALID_PICKUP_CONTEXT");}
void RemoveBag(object pc){Note("encumberedbag.remove.bag.before."+IntToString(GetWeight(pc)));DestroyObject(GetLocalObject(pc,"bag"));}
void AddShield(object pc){Note("encumberedbag.add.shield.before."+IntToString(GetWeight(pc)));object shield=CreateItemOnObject("nw_ashto001",pc);SetLocalObject(pc,"shield",shield);Note("encumberedbag.shield.valid."+IntToString(GetIsObjectValid(shield))+".owned."+IntToString(GetItemPossessor(shield)==pc)+".weight."+IntToString(GetWeight(shield)));if(!GetIsObjectValid(shield)||GetItemPossessor(shield)!=pc||GetWeight(shield)!=450)Note("INVALID_SHIELD_CONTEXT");}
void RemoveShield(object pc){Note("encumberedbag.remove.shield.before."+IntToString(GetWeight(pc)));DestroyObject(GetLocalObject(pc,"shield"));}
void Gate(object pc){int strength=GetAbilityScore(pc,ABILITY_STRENGTH);int n=StringToInt(Get2DAString("encumbrance","Normal",strength));int h=StringToInt(Get2DAString("encumbrance","Heavy",strength));SetLocalInt(pc,"normal",n);SetLocalInt(pc,"heavy",h);int valid=GetIsPC(pc)&&GetName(pc)=="Aluvian Darkstar"&&GetSoundset(pc)==5100&&GetWeight(pc)<n&&n<h;Note("encumberedbag.ready."+IntToString(valid)+".pc."+IntToString(GetIsPC(pc))+".name."+GetName(pc)+".soundset."+IntToString(GetSoundset(pc))+".base."+IntToString(GetWeight(pc))+".normal."+IntToString(n)+".heavy."+IntToString(h));if(!valid){Note("INVALID_PC_CONTEXT");VDone();return;}
DelayCommand(1.0,MakeBag(pc,3));DelayCommand(3.0,Pick(pc,3));DelayCommand(6.0,Owned(pc));DelayCommand(6.2,State(pc,"directoverload",2));DelayCommand(6.5,VShot("directoverload"));
DelayCommand(10.0,RemoveBag(pc));DelayCommand(10.5,State(pc,"directreset",0));
DelayCommand(14.0,MakeBag(pc,2));DelayCommand(15.0,Pick(pc,2));DelayCommand(18.0,Owned(pc));DelayCommand(18.2,State(pc,"encumbered",1));DelayCommand(18.5,VShot("encumbered"));
DelayCommand(21.0,AddShield(pc));DelayCommand(21.5,State(pc,"carriedoverload",2));DelayCommand(25.0,RemoveShield(pc));DelayCommand(25.5,State(pc,"carriedencumbered",1));DelayCommand(26.0,VShot("carriedencumbered"));
DelayCommand(30.0,RemoveBag(pc));DelayCommand(30.5,State(pc,"reset",0));DelayCommand(33.0,Positive(pc));DelayCommand(35.0,Note("encumberedbag.completed"));DelayCommand(36.0,VDone());}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;int i;for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");AssignCommand(pc,ClearAllActions(TRUE));SetPlotFlag(pc,TRUE);SetSoundset(pc,5100);DelayCommand(1.0,VCamera(pc,90.0,7.0,65.0));DelayCommand(2.0,Positive(pc));DelayCommand(4.0,Gate(pc));}
