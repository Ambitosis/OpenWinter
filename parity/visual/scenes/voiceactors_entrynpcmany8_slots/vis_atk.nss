void main(){if(GetLastAttacker()!=GetLocalObject(OBJECT_SELF,"expectedattacker")){WriteTimestampedLogEntry("VISUAL|note|INVALID_PC_CONTEXT.wrongattacker");return;}SetLocalInt(OBJECT_SELF,"attacks",GetLocalInt(OBJECT_SELF,"attacks")+1);WriteTimestampedLogEntry("VISUAL|note|entry.attack."+IntToString(GetLocalInt(OBJECT_SELF,"trial"))+".attackerPC."+IntToString(GetIsPC(GetLastAttacker())));}
