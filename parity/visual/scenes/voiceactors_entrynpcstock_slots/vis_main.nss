#include "visual_inc"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Quiet(object o){int i;for(i=5000;i<=5012;i++)SetEventScript(o,i,"");SetAILevel(o,AI_LEVEL_NORMAL);AssignCommand(o,ClearAllActions(TRUE));}
void Positive(object pc,int slot){Note("positive.slot."+IntToString(slot));PlayVoiceChat(slot,pc);}
void Prepare(object pc,int n){object t=CreateObject(OBJECT_TYPE_CREATURE,"nw_bandit001",Location(GetArea(pc),Vector(30.0,31.5,0.0),270.0));Quiet(t);SetPlotFlag(t,TRUE);SetCommandable(FALSE,t);SetSoundset(t,5099);ChangeToStandardFaction(t,STANDARD_FACTION_COMMONER);SetIsTemporaryEnemy(pc,t);SetIsTemporaryEnemy(t,pc);SetEventScript(t,EVENT_SCRIPT_CREATURE_ON_MELEE_ATTACKED,"vis_atk");SetLocalObject(pc,"entrytarget",t);SetLocalInt(t,"trial",n);Note("entry.prepared."+IntToString(n)+".valid."+IntToString(GetIsObjectValid(t)));}
void State(object pc,int n){object t=GetLocalObject(pc,"entrytarget");Note("entry.state."+IntToString(n)+".action."+IntToString(GetCurrentAction(pc))+".target."+IntToString(GetAttackTarget(pc)==t)+".combat."+IntToString(GetIsInCombat(pc))+".apr."+IntToString(GetAttacksPerRound(pc))+".distance."+FloatToString(GetDistanceBetween(pc,t),0,2));}
void Start(object pc,int n){object t=GetLocalObject(pc,"entrytarget");
 int ready=GetCommandable(pc)&&GetDistanceBetween(pc,t)<=2.0&&!GetIsPC(pc)&&GetName(pc)=="Bandit"&&!GetIsDead(pc)&&!GetPlotFlag(pc)&&GetBaseItemType(GetItemInSlot(INVENTORY_SLOT_RIGHTHAND,pc))==BASE_ITEM_DAGGER&&GetSoundset(pc)==5100&&GetObjectSeen(t,pc)&&GetIsEnemy(t,pc)&&!GetIsInCombat(pc);
 Note("entry.start."+IntToString(n)+".ready."+IntToString(ready)+".pc."+IntToString(GetIsPC(pc))+".name."+GetName(pc)+".weapon."+IntToString(GetBaseItemType(GetItemInSlot(INVENTORY_SLOT_RIGHTHAND,pc)))+".apr."+IntToString(GetAttacksPerRound(pc))+".commandable."+IntToString(GetCommandable(pc))+".action."+IntToString(GetCurrentAction(pc))+".distance."+FloatToString(GetDistanceBetween(pc,t),0,2)+".plot."+IntToString(GetPlotFlag(pc))+".combat."+IntToString(GetIsInCombat(pc))+".seen."+IntToString(GetObjectSeen(t,pc))+".enemy."+IntToString(GetIsEnemy(t,pc)));
 if(!ready){Note("INVALID_PC_CONTEXT");VDone();return;}
 SetLocalInt(t,"trial",n);SetLocalInt(t,"attacks",0);AssignCommand(pc,ActionAttack(t));
}
void Stop(object pc,int n){object t=GetLocalObject(pc,"entrytarget");AssignCommand(pc,ClearAllActions(TRUE));int count=GetLocalInt(t,"attacks");Note("entry.stop."+IntToString(n)+".attacks."+IntToString(count)+".pcdead."+IntToString(GetIsDead(pc)));SetIsDestroyable(TRUE,FALSE,FALSE,t);SetPlotFlag(t,FALSE);DestroyObject(t);if(count<1){Note("INVALID_ENTRY_ATTACK");VDone();}}
void main(){object controller=GetEnteringObject();if(!GetIsPC(controller))return;SetPlotFlag(controller,TRUE);SetSoundset(controller,5099);object pc=CreateObject(OBJECT_TYPE_CREATURE,"nw_bandit001",Location(GetArea(controller),Vector(30.0,30.0,0.0),90.0));ChangeToStandardFaction(pc,STANDARD_FACTION_HOSTILE);AssignCommand(controller,JumpToLocation(Location(GetArea(controller),Vector(35.0,30.0,0.0),90.0)));Quiet(pc);SetPlotFlag(pc,FALSE);SetSoundset(pc,5100);

 object dagger=CreateItemOnObject("nw_wswdg001",pc);AssignCommand(pc,ActionEquipItem(dagger,INVENTORY_SLOT_RIGHTHAND));
 DelayCommand(1.0,VCamera(controller,90.0,8.0,65.0));DelayCommand(1.0,Positive(pc,0));DelayCommand(1.4,Positive(pc,1));DelayCommand(1.8,Positive(pc,2));DelayCommand(2.2,Positive(pc,3));DelayCommand(3.0,VShot("ready"));
 int i;for(i=0;i<1;i++){float start=9.0+IntToFloat(i)*20.0;DelayCommand(start-7.0,Prepare(pc,i));DelayCommand(start,Start(pc,i));DelayCommand(start+1.0,State(pc,i));DelayCommand(start+3.0,State(pc,i));DelayCommand(start+3.2,VShot("attacking"));DelayCommand(start+7.0,State(pc,i));DelayCommand(start+8.0,Stop(pc,i));}
 DelayCommand(18.0,Note("entry.completed.1"));DelayCommand(19.0,Positive(pc,0));DelayCommand(19.4,Positive(pc,1));DelayCommand(19.8,Positive(pc,2));DelayCommand(20.2,Positive(pc,3));DelayCommand(22.0,VShot("finished"));DelayCommand(24.0,VDone());}
