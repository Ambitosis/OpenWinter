#include "visual_inc"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Quiet(object o){int i;for(i=5000;i<=5012;i++)SetEventScript(o,i,"");SetAILevel(o,AI_LEVEL_NORMAL);}
void Positive(object pc,int slot){Note("positive.slot."+IntToString(slot));PlayVoiceChat(slot,pc);}
void Gate(object pc,object t){int ready=GetIsPC(pc)&&GetName(pc)=="Aluvian Darkstar"&&!GetPlotFlag(pc)&&GetBaseItemType(GetItemInSlot(INVENTORY_SLOT_RIGHTHAND,pc))==BASE_ITEM_DAGGER&&GetSoundset(pc)==5100&&GetObjectSeen(t,pc)&&GetIsEnemy(t,pc)&&!GetIsInCombat(pc)&&GetLocalInt(t,"attacks")==0;
 Note("entry.ui.ready."+IntToString(ready)+".pc."+IntToString(GetIsPC(pc))+".name."+GetName(pc)+".weapon."+IntToString(GetBaseItemType(GetItemInSlot(INVENTORY_SLOT_RIGHTHAND,pc)))+".seen."+IntToString(GetObjectSeen(t,pc))+".enemy."+IntToString(GetIsEnemy(t,pc))+".combat."+IntToString(GetIsInCombat(pc))+".attacks."+IntToString(GetLocalInt(t,"attacks")));if(!ready){Note("INVALID_PC_CONTEXT");VDone();}}
void Finish(object pc,object t){int count=GetLocalInt(t,"attacks");AssignCommand(pc,ClearAllActions(TRUE));Note("entry.ui.completed.attacks."+IntToString(count)+".dead."+IntToString(GetIsDead(pc)));if(count<1)Note("INVALID_ENTRY_ATTACK");}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;Quiet(pc);SetPlotFlag(pc,FALSE);SetSoundset(pc,5100);
 object t=CreateObject(OBJECT_TYPE_CREATURE,"nw_dwarfmerc005",Location(GetArea(pc),GetPosition(pc)+Vector(3.0,0.0,0.0),180.0));Quiet(t);SetPlotFlag(t,TRUE);SetCommandable(FALSE,t);SetSoundset(t,5099);ChangeToStandardFaction(t,STANDARD_FACTION_HOSTILE);SetIsTemporaryEnemy(pc,t);SetIsTemporaryEnemy(t,pc);SetEventScript(t,EVENT_SCRIPT_CREATURE_ON_MELEE_ATTACKED,"vis_atk");SetName(t,"Attack Voice Reference");
 AssignCommand(pc,ActionEquipItem(GetItemPossessedBy(pc,"NW_WSWDG001"),INVENTORY_SLOT_RIGHTHAND));
 DelayCommand(1.0,Positive(pc,0));DelayCommand(1.4,Positive(pc,1));DelayCommand(1.8,Positive(pc,2));DelayCommand(2.2,Positive(pc,3));DelayCommand(2.5,VCamera(pc,90.0,8.0,60.0));DelayCommand(3.5,VShot("world"));DelayCommand(6.0,Gate(pc,t));
 DelayCommand(7.0,WriteTimestampedLogEntry("VISUAL|hover|0.754,0.525"));DelayCommand(7.3,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.525|down|right"));DelayCommand(8.3,VShot("root"));DelayCommand(9.3,WriteTimestampedLogEntry("VISUAL|key|102|tap"));DelayCommand(11.8,WriteTimestampedLogEntry("VISUAL|mouse|0.754,0.525|up|right"));DelayCommand(13.0,VShot("attack"));DelayCommand(18.0,Finish(pc,t));DelayCommand(19.0,Positive(pc,0));DelayCommand(19.4,Positive(pc,1));DelayCommand(19.8,Positive(pc,2));DelayCommand(20.2,Positive(pc,3));DelayCommand(22.0,VShot("finished"));DelayCommand(24.0,VDone());}
