#include "visual_inc"
#include "vis_bindings"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Positive(object h){Note("nearhench.positive.slot.17");PlayVoiceChat(17,h);}
void Done(object h){int count=GetLocalInt(h,"attempts");Note("nearhench.completed."+IntToString(count));if(count!=100)Note("INVALID_CALL_COUNT");VDone();}
void Gate(object pc,object h){int good=BlankBindings(h)&&GetIsPC(pc)&&GetName(pc)=="Aluvian Darkstar"&&GetIsObjectValid(h)&&GetMaster(h)==pc&&GetAssociateType(h)==ASSOCIATE_TYPE_HENCHMAN&&GetSoundset(h)==5100&&GetCurrentHitPoints(h)==1&&GetMaxHitPoints(h)==12&&GetFirstItemInInventory(h)==OBJECT_INVALID;Note("nearhench.ready."+IntToString(good)+".type."+IntToString(GetAssociateType(h))+".hp."+IntToString(GetCurrentHitPoints(h))+".max."+IntToString(GetMaxHitPoints(h))+".masterPC."+IntToString(GetIsPC(GetMaster(h))));if(!good){Note("INVALID_HENCH_CONTEXT");VDone();return;}
int i;for(i=0;i<100;i++)DelayCommand(1.0+IntToFloat(i)*.3,ExecuteScript("vis_trial",h));DelayCommand(33.0,VShot("completed"));DelayCommand(34.0,Positive(h));DelayCommand(36.0,Done(h));}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;int i;for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");SetSoundset(pc,5099);SetPlotFlag(pc,TRUE);object h=CreateObject(OBJECT_TYPE_CREATURE,"nw_bandit001",Location(GetArea(pc),Vector(30.0,31.5,0.0),270.0));for(i=5000;i<=5012;i++)SetEventScript(h,i,"");AssignCommand(h,ClearAllActions(TRUE));SetSoundset(h,5100);AddHenchman(pc,h);object item=GetFirstItemInInventory(h);while(GetIsObjectValid(item)){DestroyObject(item);item=GetNextItemInInventory(h);}SetCurrentHitPoints(h,1);SetImmortal(h,FALSE);SetPlotFlag(h,FALSE);DelayCommand(1.0,VCamera(pc,90.0,8.0,65.0));DelayCommand(2.0,Positive(h));DelayCommand(4.0,Gate(pc,h));}
