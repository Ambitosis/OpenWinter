#include "x0_inc_henai"
#include "vis_bindings"
void main(){object h=OBJECT_SELF;int n=GetLocalInt(h,"attempts")+1;SetLocalInt(h,"attempts",n);int hp=GetCurrentHitPoints(h);int maximum=GetMaxHitPoints(h);int type=GetAssociateType(h);int master=GetIsPC(GetMaster(h));int bindings=BlankBindings(h);if(!bindings||hp!=1||maximum!=12||type!=ASSOCIATE_TYPE_HENCHMAN||!master){WriteTimestampedLogEntry("VISUAL|note|INVALID_AI_CONTEXT");return;}int result=bkCombatAttemptHeal();WriteTimestampedLogEntry("VISUAL|note|nearhench.attempt."+IntToString(n)+".hp."+IntToString(hp)+".max."+IntToString(maximum)+".type."+IntToString(type)+".masterPC."+IntToString(master)+".bindings."+IntToString(bindings)+".result."+IntToString(result)+".afterHP."+IntToString(GetCurrentHitPoints(h)));if(result||GetCurrentHitPoints(h)!=1)WriteTimestampedLogEntry("VISUAL|note|INVALID_HEAL_CONTEXT");}
