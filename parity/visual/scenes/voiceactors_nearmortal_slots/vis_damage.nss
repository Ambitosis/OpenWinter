void main(){int n=GetLocalInt(OBJECT_SELF,"damage_events")+1;SetLocalInt(OBJECT_SELF,"damage_events",n);string phase=GetLocalString(OBJECT_SELF,"phase");if(phase=="combat")SetLocalInt(OBJECT_SELF,"combat_damage",GetLocalInt(OBJECT_SELF,"combat_damage")+1);WriteTimestampedLogEntry("VISUAL|note|near.damage.event."+IntToString(n)+".phase."+phase+".amount."+IntToString(GetTotalDamageDealt())+".hp."+IntToString(GetCurrentHitPoints(OBJECT_SELF)));}
