#include "visual_inc"
void Note(string s){WriteTimestampedLogEntry("VISUAL|note|"+s);}
void Positive(object pc){Note("near.positive.slot.17");PlayVoiceChat(17,pc);}
void State(object pc,string phase,int expected){int hp=GetCurrentHitPoints(pc);Note("near.state."+phase+".hp."+IntToString(hp)+".max."+IntToString(GetMaxHitPoints(pc))+".dead."+IntToString(GetIsDead(pc))+".damage."+IntToString(GetLocalInt(pc,"damage_events")));if(GetIsDead(pc)||(expected>=0&&hp!=expected))Note("INVALID_HP_CONTEXT");}
void SetHp(object pc,string phase,int hp){Note("near.set."+phase+".before."+IntToString(GetCurrentHitPoints(pc))+".requested."+IntToString(hp));SetCurrentHitPoints(pc,hp);DelayCommand(.2,State(pc,phase,hp));}
void Damage(object pc){SetLocalString(pc,"phase","script");Note("near.damage.script.before."+IntToString(GetCurrentHitPoints(pc)));ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectDamage(10,DAMAGE_TYPE_MAGICAL),pc);DelayCommand(.2,State(pc,"scriptlow",1));}
void Attack(object pc,object attacker){int good=GetIsObjectValid(attacker)&&GetObjectSeen(pc,attacker)&&GetIsEnemy(pc,attacker);Note("near.combat.ready."+IntToString(good));if(!good){Note("INVALID_ATTACK_CONTEXT");return;}SetLocalString(pc,"phase","combat");AssignCommand(attacker,ActionAttack(pc));}
void Stop(object pc,object attacker){AssignCommand(attacker,ClearAllActions(TRUE));State(pc,"combatlow",1);if(GetLocalInt(pc,"combat_damage")<1)Note("INVALID_NO_COMBAT_DAMAGE");}
void Gate(object pc,object attacker){int good=GetIsPC(pc)&&GetName(pc)=="Aluvian Darkstar"&&GetSoundset(pc)==5100&&GetMaxHitPoints(pc)==11&&!GetImmortal(pc);Note("near.ready."+IntToString(good)+".pc."+IntToString(GetIsPC(pc))+".name."+GetName(pc)+".soundset."+IntToString(GetSoundset(pc))+".max."+IntToString(GetMaxHitPoints(pc)));if(!good){Note("INVALID_PC_CONTEXT");VDone();return;}
DelayCommand(1.0,SetHp(pc,"set9",9));DelayCommand(5.0,SetHp(pc,"set6",6));DelayCommand(9.0,SetHp(pc,"set2",2));DelayCommand(13.0,SetHp(pc,"set1",1));DelayCommand(17.0,VShot("setlow"));
DelayCommand(23.0,SetHp(pc,"reset1",11));DelayCommand(27.0,Damage(pc));DelayCommand(31.0,VShot("scriptlow"));DelayCommand(35.0,Positive(pc));DelayCommand(37.0,Note("near.completed"));DelayCommand(38.0,VDone());}
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;int i;for(i=5000;i<=5012;i++)SetEventScript(pc,i,"");AssignCommand(pc,ClearAllActions(TRUE));SetPlotFlag(pc,FALSE);SetImmortal(pc,FALSE);SetCommandable(FALSE,pc);SetSoundset(pc,5100);Note("near.original.max."+IntToString(GetMaxHitPoints(pc))+".con."+IntToString(GetAbilityScore(pc,ABILITY_CONSTITUTION)));ApplyEffectToObject(DURATION_TYPE_PERMANENT,EffectAbilityIncrease(ABILITY_CONSTITUTION,20),pc);SetEventScript(pc,EVENT_SCRIPT_CREATURE_ON_DAMAGED,"vis_damage");object attacker=OBJECT_INVALID;Note("near.immortal."+IntToString(GetImmortal(pc)));DelayCommand(1.0,VCamera(pc,90.0,8.0,65.0));DelayCommand(2.0,Positive(pc));DelayCommand(4.0,Gate(pc,attacker));}
