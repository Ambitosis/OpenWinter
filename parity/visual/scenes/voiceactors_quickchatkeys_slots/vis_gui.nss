void main(){int k=GetLastGuiEventType();if(k>=18&&k<=20){if(k==18)SetLocalInt(GetModule(),"quickchat_keys_open",1);else if(k==20)SetLocalInt(GetModule(),"quickchat_keys_open",0);else if(k==19){int stage=GetLocalInt(GetModule(),"quickchat_keys_open");SetLocalInt(GetModule(),"quickchat_keys_open",stage==1?2:0);}SetLocalInt(GetModule(),"quickchat_last_gui",k);WriteTimestampedLogEntry("VISUAL|note|quickchat.gui.trial."+IntToString(GetLocalInt(GetModule(),"quickchat_trial"))+".type."+IntToString(k)+".integer."+IntToString(GetLastGuiEventInteger())+".pc."+IntToString(GetIsPC(GetLastGuiEventPlayer())));}}
