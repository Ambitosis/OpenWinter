void main(){int n=GetLocalInt(OBJECT_SELF,"damage_events")+1;SetLocalInt(OBJECT_SELF,"damage_events",n);WriteTimestampedLogEntry("VISUAL|note|damage.event."+IntToString(n)+".phase."+IntToString(GetLocalInt(OBJECT_SELF,"phase"))+".amount."+IntToString(GetTotalDamageDealt())+".hp."+IntToString(GetCurrentHitPoints(OBJECT_SELF)));DelayCommand(.2,ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectHeal(1000),OBJECT_SELF));}
