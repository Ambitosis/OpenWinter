<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenWinter.Game\OpenWinter.Game.csproj" />
    <ProjectReference Include="..\..\src\OpenWinter.Net.Nwn\OpenWinter.Net.Nwn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Data" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\OpenWinter.Tools\ParityResultGuard.cs" Link="Tools\ParityResultGuard.cs" />
    <!-- Godot-free client code under test (the client project itself needs Godot). -->
    <Compile Include="..\..\client\UI\Nui\Model\*.cs" Link="ClientNui\%(Filename)%(Extension)" />
    <!-- Godot-free client logic (world presentation) tested here; the client project compiles it too. -->
    <Compile Include="..\..\client\Views\WorldFx\Logic\*.cs" Link="ClientLogic\%(Filename)%(Extension)" />
    <!-- Godot-free settings model (options, key bindings). -->
    <Compile Include="..\..\client\Settings\Model\*.cs" Link="ClientSettings\%(Filename)%(Extension)" />
    <!-- Godot-free control logic (camera modes, radial numpad, tooltip latch, quick groups). -->
    <Compile Include="..\..\client\Gameplay\Logic\*.cs" Link="ClientGameplay\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
